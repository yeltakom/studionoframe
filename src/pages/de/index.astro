---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkIndex from '../../components/WorkIndex.astro';
import { getProjects } from '../../lib/projects';
import { studioSchema } from '../../lib/schema';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');
const projects = await getProjects('de');
---

<BaseLayout
  lang="de"
  image={`${base}/images/og/default.jpg`}
  schema={studioSchema('de', site, base, projects)}
>
  <WorkIndex lang="de" home={`${base}/de`} base={base} projects={projects} />
</BaseLayout>
