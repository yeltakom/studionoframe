---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectPlate from '../../../components/ProjectPlate.astro';
import { getProjects } from '../../../lib/projects';
import { projectSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const projects = await getProjects('de');
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? projects[projects.length - 1],
      next: projects[i + 1] ?? projects[0],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project.entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');
const { data } = project;
---

<BaseLayout
  lang="de"
  title={`${data.title} — ${data.venue}`}
  description={data.summary}
  image={`${base}/images/og/${project.id}.jpg`}
  schema={projectSchema('de', site, base, project.id, data)}
>
  <ProjectPlate
    lang="de"
    home={`${base}/de`}
    base={base}
    data={data}
    prev={{ id: prev.id, title: prev.data.title }}
    next={{ id: next.id, title: next.data.title }}
  >
    <Content />
  </ProjectPlate>
</BaseLayout>
