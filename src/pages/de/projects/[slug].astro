---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Chrome from '../../../components/Chrome.astro';
import SiteFoot from '../../../components/SiteFoot.astro';
import RProject from '../../../components/RProject.astro';
import { getThreaded } from '../../../lib/threads';
import { projectSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const works = await getThreaded('de');
  return works.map((p, i) => ({ params: { slug: p.id }, props: { p, prev: works[i - 1] ?? works[works.length - 1], next: works[i + 1] ?? works[0] } }));
}
const lang = 'de' as const;
const { p, prev, next } = Astro.props;
const { Content } = await render(p.entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = `${base}/de`;
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');
---
<Base lang={lang} title={`${p.data.title} — ${p.data.venue}`} description={p.data.summary} image={`${base}${p.data.cover}`} schema={projectSchema(lang, site, base, p.id, p.data)}>
  <Chrome lang={lang} />
  <div class="below"></div>
  <RProject p={p} prev={prev} next={next} root={`${home}/projects`} threadHref={`${home}/works#${p.thread.key}`} lang={lang}><Content /></RProject>
  <SiteFoot lang={lang} />
</Base>
