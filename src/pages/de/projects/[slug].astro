---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Chrome from '../../../components/Chrome.astro';
import { getProjects } from '../../../lib/projects';
import { getRegister } from '../../../lib/register';
import { projectSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const nrOf = new Map((await getRegister()).map((e) => [e.id, e.nr]));
  const order = (await getProjects('de')).slice().sort((a, b) => Number(nrOf.get(b.id)) - Number(nrOf.get(a.id)));
  return order.map((project, i) => ({
    params: { slug: project.id },
    props: { project, nr: nrOf.get(project.id) ?? '', next: order[i + 1] ?? order[0] },
  }));
}

const { project, nr, next } = Astro.props;
const { Content } = await render(project.entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');
const { title, venue, year, role, summary, images } = project.data;
const [lead, ...rest] = images;
---

<Base
  lang="de"
  title={`${title} — ${venue}`}
  description={summary}
  image={`${base}/images/og/${project.id}.jpg`}
  schema={projectSchema('de', site, base, project.id, project.data)}
>
  <Chrome lang="de" count={nr} />

  {lead && (
    <section class="hero">
      <img src={`${base}${lead}`} alt={`${title} — ${venue}`} fetchpriority="high" decoding="async" />
      <div class="set">
        <h1>{title}</h1>
        <p class="chip">{venue} · {year}<br /><b>{role}</b></p>
      </div>
    </section>
  )}

  <div class="read"><Content /></div>

  <div class="plates">
    {rest.map((src: string, i: number) => (
      <figure>
        <img src={`${base}${src}`} alt={`${title} — ${venue}`} loading="lazy" decoding="async" />
        <figcaption>{nr}.{String(i + 2).padStart(2, '0')}</figcaption>
      </figure>
    ))}
  </div>

  <a class="tail" href={`${base}/de/projects/${next.id}`}>
    <span>Weiter</span>
    <strong>{next.data.title}</strong>
  </a>
</Base>
