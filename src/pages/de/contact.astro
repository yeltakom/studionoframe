---
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import SiteFoot from '../../components/SiteFoot.astro';
import { SITE } from '../../site';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base lang="de"
  title="Kontakt"
  description="Studio No Frame für Ausstellungsarchitektur, Produktion oder Kuratierung beauftragen. Schreiben Sie an contact@noframe.studio mit Ausstellung, Ort und Zeitraum."
>
  <Chrome lang="de" here="contact" />
  <section class="page">
    <h1>Kontakt</h1>

    <div class="body">
      <p>
        Studio No Frame, Berlin. Für Ausstellungsarchitektur, Produktion und
        Kuration schreiben Sie uns mit Ausstellung, Ort und Zeitraum. Wir
        antworten mit dem vollständigen Portfolio.
      </p>
      <p>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p>
        Sie suchen ein Praktikum? Lesen Sie zuerst die
        {' '}<a href={`${base}/de/internships`}>Praktikumsseite</a>. Dort steht, was
        wir anbieten und was Sie schicken sollten.
      </p>
    </div>
  </section>
  <SiteFoot lang="de" />
</Base>
