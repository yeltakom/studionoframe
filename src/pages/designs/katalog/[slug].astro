---
import { render } from 'astro:content';
import ThemeShell from '../../../layouts/ThemeShell.astro';
import { getProjects } from '../../../lib/projects';
import '../../../styles/t-katalog.css';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, next: projects[i + 1] ?? projects[0] },
  }));
}

const { project, index, next } = Astro.props;
const { Content } = await render(project.entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { title, venue, year, role, images } = project.data;
const [lead, ...rest] = images;
const FONTS = 'family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=EB+Garamond:ital,wght@0,400..600;1,400..500';
---

<ThemeShell title={`${title} — Katalog`} theme="katalog" fonts={FONTS}>
  <header class="entry-head">
    <p class="imprint reveal">Tafel {String(index + 1).padStart(2, '0')}</p>
    <h1 class="reveal">{title}</h1>
    <p class="credits reveal">{venue}, {year} — {role}</p>
  </header>

  {lead && (
    <div class="entry-lead reveal">
      <img src={`${base}${lead}`} alt={`${title} — ${venue}`} fetchpriority="high" decoding="async" />
    </div>
  )}

  <div class="entry-text reveal"><Content /></div>

  <div class="entry-plates">
    {rest.map((src: string, i: number) => (
      <figure>
        <img src={`${base}${src}`} alt={`${title} — ${venue}`} loading="lazy" decoding="async" />
        <figcaption>Abb. {String(i + 2).padStart(2, '0')} — {venue}</figcaption>
      </figure>
    ))}
  </div>

  <a class="entry-next" href={`${base}/designs/katalog/${next.id}`}>
    <span>Nächste Tafel</span>
    <strong>{next.data.title}</strong>
  </a>
</ThemeShell>
