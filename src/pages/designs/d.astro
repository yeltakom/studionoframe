---
import PreviewShell from '../../layouts/PreviewShell.astro';
import { getProjects } from '../../lib/projects';
import '../../styles/dir-d.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const projects = await getProjects('en');
const first = projects[0];
---

<PreviewShell title="Studio No Frame — Fassade" variant="d">
  <div class="layout">
    <aside class="rail">
      <h1>Studio No Frame</h1>
      <p class="intro">Exhibition architecture, production and curation. Berlin.</p>
      <nav>
        <a href={`${base}/about`}>About</a>
        <a href="mailto:contact@noframe.studio">Contact</a>
      </nav>

      <dl class="now" aria-live="polite">
        <dt>Exhibition</dt>
        <dd class="title" data-now="title">{first.data.title}</dd>
        <dt>Venue</dt>
        <dd data-now="venue">{first.data.venue}</dd>
        <dt>Year</dt>
        <dd data-now="year">{first.data.year}</dd>
        <dt>Role</dt>
        <dd data-now="role">{first.data.role}</dd>
        <dd class="count"><span data-now="index">1</span> / {projects.length}</dd>
      </dl>
    </aside>

    <div class="field">
      {projects.map((p, i) => (
        <a
          class="work"
          href={`${base}/projects/${p.id}`}
          data-index={i + 1}
          data-title={p.data.title}
          data-venue={p.data.venue}
          data-year={p.data.year}
          data-role={p.data.role}
        >
          <img
            src={`${base}${p.data.cover}`}
            alt={`${p.data.title} — ${p.data.venue}`}
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <span class="marker">{p.data.title}</span>
        </a>
      ))}
    </div>
  </div>

  <script is:inline>
    const fields = ['title', 'venue', 'year', 'role', 'index'];
    const out = Object.fromEntries(fields.map((f) => [f, document.querySelector(`[data-now="${f}"]`)]));
    const works = document.querySelectorAll('.work');

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        const d = visible.target.dataset;
        out.title.textContent = d.title;
        out.venue.textContent = d.venue;
        out.year.textContent = d.year;
        out.role.textContent = d.role;
        out.index.textContent = d.index;
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );

    works.forEach((w) => observer.observe(w));
  </script>
</PreviewShell>
