---
import { render } from 'astro:content';
import Sade from './_Sade.astro';
import { getCatalogue } from '../../../lib/categories';
import { srcset, dims } from '../../../lib/img';

export async function getStaticPaths() {
  const works = (await getCatalogue('en')).sort((a, b) => b.year - a.year || a.data.order - b.data.order);
  return works.map((p, i) => ({ params: { slug: p.id }, props: { p, next: works[i + 1] ?? works[0] } }));
}
const { p, next } = Astro.props;
const d = p.data;
const { Content } = await render(p.entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const caps = d.captions as { image: string; text: string; credit: string }[];
const capOf = (src: string) => caps.find((c) => c.image === src)?.text ?? '';
/* landscape photographs and drawings run full width; upright ones take half
   the page, alternating left and right */
let side = 0;
const ims = [...new Set(d.images as string[])].map((src) => {
  const { w, h } = dims(src);
  const half = w / h < 1.1;
  return { src, w, h, half, right: half ? side++ % 2 === 1 : false };
});
const facts = [
  ['Venue', d.venue], [d.dates ? 'Dates' : 'Year', d.dates || d.year], ['Role', d.role],
  ['Curator', d.curator], ['Artists', d.artists], ['Team', d.team], ['Photography', d.photo],
].filter(([, v]) => v);
---
<Sade title={d.title} here="work">
  <section class="s-pj-top">
    <div>
      <h1>{d.title}</h1>
      <p class="mute" style="margin:0">{d.venue}, {d.year}</p>
      <div class="s-text"><Content /></div>
    </div>
    <dl class="s-facts">
      {facts.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
    </dl>
  </section>
  <div class="s-ims">
    {ims.map((m, i) => (
      <figure class:list={[m.half && 'half', m.right && 'r']}>
        <img src={`${base}${m.src}`} srcset={srcset(base, m.src)} sizes={m.half ? '50vw' : '100vw'} width={m.w} height={m.h} alt={capOf(m.src) || d.title} loading={i ? 'lazy' : undefined} decoding="async" />
        {capOf(m.src) && <figcaption>{capOf(m.src)}</figcaption>}
      </figure>
    ))}
  </div>
  <nav class="s-next">
    <a href={`${base}/designs/sade/`} class="mute">All work</a>
    <a href={`${base}/designs/sade/${next.id}/`}>Next: {next.data.title}</a>
  </nav>
</Sade>
