---
/* C: the index is the home. One sentence, then a quiet list; the photograph
   of the row under the cursor fills the right half (Arkitektkontoret Vest's
   list mode, our own earlier hover-figure) */
import Sade from '../_Sade.astro';
import { works, sentence } from '../_works';
import { srcset } from '../../../../lib/img';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const list = await works();
---
<Sade here="work">
  <div class="ev-c">
    <div class="ev-c-l">
      <p class="ev-line">{sentence}</p>
      <ul>
        {list.map((p, i) => (
          <li><a href={`${base}/designs/sade/${p.id}/`} data-i={i}><span>{p.data.title}</span><span class="mute">{p.data.year}</span></a></li>
        ))}
      </ul>
    </div>
    <div class="ev-c-r">
      {list.map((p, i) => (
        <img src={`${base}${p.data.cover}`} srcset={srcset(base, p.data.cover)} sizes="50vw" alt="" class:list={[i === 0 && 'on']} data-i={i} loading={i < 3 ? undefined : 'lazy'} decoding="async" />
      ))}
    </div>
  </div>
</Sade>
<style>
  .ev-c { display: grid; grid-template-columns: 1fr 1fr; gap: var(--g); padding: 0 var(--g); }
  .ev-line { max-width: 22em; margin: 0; padding: 80px 0 80px; font-size: clamp(22px, 2.6vw, 34px); line-height: 1.2; letter-spacing: -0.01em; }
  ul { list-style: none; margin: 0; padding: 0; }
  li a { display: flex; justify-content: space-between; gap: var(--g); padding: 5px 0; color: var(--mute); transition: color .2s; }
  li a:hover, li a.on { color: var(--ink); }
  li a .mute { color: inherit; }
  .ev-c-r { position: sticky; top: 70px; height: calc(100vh - 90px); }
  .ev-c-r img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: right top; opacity: 0; transition: opacity .4s; }
  .ev-c-r img.on { opacity: 1; }
  @media (max-width: 760px) { .ev-c { grid-template-columns: 1fr; } .ev-c-r { display: none; } li a { color: var(--ink); } }
</style>
<script>
  const imgs = [...document.querySelectorAll<HTMLImageElement>('.ev-c-r img')];
  document.querySelectorAll<HTMLAnchorElement>('.ev-c li a').forEach((a) => a.addEventListener('mouseenter', () => {
    imgs.forEach((im) => im.classList.toggle('on', im.dataset.i === a.dataset.i));
  }));
</script>
