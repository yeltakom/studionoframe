---
/* F: the index is the home, in large type. Hovering a line fills the whole
   window with that project's photograph behind the list. */
import Sade from '../_Sade.astro';
import { works } from '../_works';
import { srcset } from '../../../../lib/img';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const list = await works();
---
<Sade here="work">
  <div class="ev-f">
    <div class="ev-f-bg">
      {list.map((p, i) => (
        <img src={`${base}${p.data.cover}`} srcset={srcset(base, p.data.cover)} sizes="100vw" alt="" data-i={i} loading={i < 3 ? undefined : 'lazy'} decoding="async" />
      ))}
    </div>
    <ul class="ev-f-list">
      {list.map((p, i) => (
        <li><a href={`${base}/designs/sade/${p.id}/`} data-i={i}>{p.data.title}<span>{p.data.venue}, {p.data.year}</span></a></li>
      ))}
    </ul>
  </div>
</Sade>
<style>
  .ev-f { position: relative; min-height: 100vh; }
  .ev-f-bg { z-index: -1; }
  .ev-f-bg { position: fixed; inset: 0; z-index: -1; background: #fff; }
  .ev-f-bg img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .5s; }
  .ev-f-bg img.on { opacity: 1; }
  .ev-f-bg::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,.45); opacity: 0; transition: opacity .5s; }
  .ev-f.lit .ev-f-bg::after { opacity: 1; }
  .ev-f-list { list-style: none; margin: 0; padding: 40px var(--g) 120px; }
  .ev-f-list a { display: block; padding: 6px 0; font-size: clamp(24px, 3.2vw, 44px); line-height: 1.1; letter-spacing: -0.015em; color: var(--ink); transition: color .25s; }
  .ev-f-list a span { display: block; font-size: 15px; letter-spacing: 0; line-height: 1.4; color: var(--mute); margin: 2px 0 12px; }
  .ev-f.lit .ev-f-list a { color: #fff; }
  .ev-f.lit .ev-f-list a span { color: #fff; opacity: .7; }
  .ev-f.lit .ev-f-list a:not(:hover) { opacity: .5; }
</style>
<script>
  const root = document.querySelector('.ev-f')!; const bg = document.querySelector('.ev-f-bg')!;
  const imgs = [...document.querySelectorAll<HTMLImageElement>('.ev-f-bg img')];
  document.querySelectorAll<HTMLAnchorElement>('.ev-f-list a').forEach((a) => {
    a.addEventListener('mouseenter', () => { root.classList.add('lit'); imgs.forEach((im) => im.classList.toggle('on', im.dataset.i === a.dataset.i)); });
    a.addEventListener('mouseleave', () => { root.classList.remove('lit'); imgs.forEach((im) => im.classList.remove('on')); });
  });
</script>
