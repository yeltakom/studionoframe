---
/* D: full-screen. One photograph fills the window; scrolling snaps from
   project to project. Name bottom-left, counter bottom-right. */
import Sade from '../_Sade.astro';
import { works } from '../_works';
import { srcset } from '../../../../lib/img';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const list = await works();
const pad = (n: number) => String(n).padStart(2, '0');
---
<Sade here="work">
  <div class="ev-d">
    {list.map((p, i) => (
      <a href={`${base}/designs/sade/${p.id}/`} class="ev-d-s">
        <img src={`${base}${p.data.cover}`} srcset={srcset(base, p.data.cover)} sizes="100vw" alt={p.data.title} loading={i < 2 ? undefined : 'lazy'} decoding="async" />
        <p class="ev-d-n">{p.data.title}<br /><span>{p.data.venue}, {p.data.year}</span></p>
        <p class="ev-d-c">{pad(i + 1)} / {pad(list.length)}</p>
      </a>
    ))}
  </div>
</Sade>
<style is:global>
  .s-head { position: fixed; left: 0; right: 0; mix-blend-mode: difference; color: #fff; background: none; }
  .s-head nav a, .s-head nav a.on { color: #fff; } .s-head nav a { opacity: .6; } .s-head nav a:hover, .s-head nav a.on { opacity: 1; }
  .s-foot { display: none; }
  .ev-d { scroll-snap-type: y mandatory; height: 100vh; overflow-y: auto; }
  .ev-d-s { position: relative; display: block; height: 100vh; scroll-snap-align: start; background: #111; }
  .ev-d-s img { width: 100%; height: 100%; object-fit: cover; }
  .ev-d-n, .ev-d-c { position: absolute; bottom: var(--g); margin: 0; color: #fff; mix-blend-mode: difference; }
  .ev-d-n { left: var(--g); } .ev-d-n span { opacity: .7; }
  .ev-d-c { right: var(--g); font-variant-numeric: tabular-nums; }
</style>
