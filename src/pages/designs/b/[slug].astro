---
import { getCollection, render } from 'astro:content';
import PreviewLayout from '../../../layouts/PreviewLayout.astro';
import '../../../styles/design-b.css';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[i + 1] ?? projects[0] },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { title, venue, year, role, images } = project.data;
---

<PreviewLayout title={`${title} — Studio No Frame`} variant="b" fonts="family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500">
  <div class="sheet">
    <div class="sheet-head">
      <a class="wordmark" href={`${base}/designs/b`}>Studio No Frame</a>
      <span>{venue} · {year}</span>
      <nav><a href={`${base}/designs/b#plan`}>Back to plan</a></nav>
    </div>

    <div class="dimension" aria-hidden="true"></div>

    <div class="plate-head">
      <h1>{title}</h1>
      <div class="body">
        <Content />
        <p class="mono" style="font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--soft)">{role}</p>
      </div>
    </div>

    <div class="plates">
      {images.map((image, i) => (
        <figure>
          <img src={`${base}${image}`} alt={`${title} — installation view ${i + 1}`} loading="lazy" />
          <figcaption class="plate-caption">{String(i + 1).padStart(2, '0')} / {String(images.length).padStart(2, '0')}</figcaption>
        </figure>
      ))}
    </div>

    <dl class="titleblock">
      <div><dt>Exhibition</dt><dd>{title}</dd></div>
      <div><dt>Venue</dt><dd>{venue}</dd></div>
      <div><dt>Year</dt><dd>{year}</dd></div>
      <div><dt>Role</dt><dd>{role}</dd></div>
      <div><dt>Next</dt><dd><a href={`${base}/designs/b/${next.id}`}>{next.data.title} →</a></dd></div>
    </dl>
  </div>
</PreviewLayout>
