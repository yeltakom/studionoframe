---
/* Giriş A — Protokoll: the home is a dated log, like raumlabor / OMA.
   No headline; the studio line in one sentence, then every project as a
   dated entry, newest first, year shown only when it changes. */
import Base from '../../../layouts/Base.astro';
import Chrome from '../../../components/Chrome.astro';
import SiteFoot from '../../../components/SiteFoot.astro';
import { getCatalogue, catTitle } from '../../../lib/categories';
import { srcset } from '../../../lib/img';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const works = (await getCatalogue('en')).sort((a, b) => b.year - a.year || b.data.order - a.data.order);
const now = works.filter((w) => w.data.current);
let last = 0;
---
<Base title="Giriş A — Protokoll">
  <Chrome here="selected" />
  <div class="below"></div>
  <section class="log">
    <p class="intro">Studio No Frame is a spatial-experience research office in Berlin and Istanbul. Since 2014 it has designed and built exhibitions for museums, biennials and artists, and kept a record of what each space did to the people inside it.</p>
    {now.length > 0 && <p class="onview"><span class="no">On view</span>{now.map((w) => <a href={`${base}/projects/${w.id}`}>{w.data.title}, {w.data.venue}{w.data.dates ? ` — ${w.data.dates}` : ''}</a>)}</p>}
    <ol>
      {works.map((w, i) => { const show = w.year !== last; last = w.year; return (
        <li style={`--i:${i}`}>
          <span class="yr">{show ? w.year : ''}</span>
          <span class="kind">{catTitle(w.cat, 'en')}</span>
          <div class="txt">
            <a href={`${base}/projects/${w.id}`}><b>{w.data.title}</b></a>
            <span class="venue">{w.data.venue}</span>
            <p>{w.data.summary}</p>
          </div>
          <a class="fig th" href={`${base}/projects/${w.id}`} tabindex="-1"><img src={`${base}${w.data.cover}`} srcset={srcset(base, w.data.cover)} sizes="160px" alt="" loading={i < 3 ? 'eager' : 'lazy'} /><i></i></a>
        </li>
      ); })}
    </ol>
  </section>
  <SiteFoot />
</Base>

<style>
  .log { padding: clamp(1.5rem, 5vh, 3rem) var(--gutter) clamp(3rem, 7vw, 5rem); }
  .intro { margin: 0; max-width: 54ch; font-size: clamp(1.1rem, 1.6vw, 1.45rem); line-height: 1.32; letter-spacing: -0.015em; }
  .onview { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin: 1.5rem 0 0; font-family: var(--mono); font-size: 0.72rem; }
  .onview .no { color: var(--mark); }
  .onview a { border-bottom: 1px solid var(--rule); }
  ol { list-style: none; margin: clamp(2.5rem, 6vh, 4rem) 0 0; padding: 0; border-top: 1px solid var(--ink); }
  li { display: grid; grid-template-columns: 6rem 10rem minmax(0, 1fr) 10rem; gap: 0 clamp(1rem, 2.5vw, 2.5rem); padding: 1.1rem 0 1.3rem; border-bottom: 1px solid var(--rule); align-items: start;
       animation: in 0.5s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 35ms); }
  @keyframes in { from { opacity: 0; transform: translateY(8px); } }
  .yr { font-family: var(--mono); font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1; padding-top: 0.15rem; letter-spacing: -0.03em; }
  .kind { font-family: var(--mono); font-size: 0.68rem; color: var(--grey); padding-top: 0.5rem; }
  .txt b { font-weight: 600; font-stretch: 112%; font-size: clamp(1.15rem, 1.8vw, 1.6rem); line-height: 1.05; letter-spacing: -0.025em; display: inline; }
  .txt a:hover b { color: var(--mark); }
  .venue { display: block; margin-top: 0.35rem; font-family: var(--mono); font-size: 0.72rem; }
  .txt p { margin: 0.6rem 0 0; max-width: 58ch; color: var(--grey); font-size: 0.92rem; }
  .th { width: 10rem; }
  .th img { aspect-ratio: 3/2; object-fit: cover; }
  @media (max-width: 760px) {
    li { grid-template-columns: 3.4rem minmax(0, 1fr); }
    .yr { font-size: 0.9rem; }
    .kind { grid-column: 2; padding-top: 0; }
    .txt { grid-column: 2; }
    .th { grid-column: 2; width: 7rem; margin-top: 0.8rem; }
  }
</style>
