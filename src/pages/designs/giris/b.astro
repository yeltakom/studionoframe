---
/* Giriş B — Inhalt: the home is a preface and a table of contents, like a
   book (Formafantasma). No photographs on the page; a figure appears in the
   corner only while a line is under the pointer. */
import Base from '../../../layouts/Base.astro';
import Chrome from '../../../components/Chrome.astro';
import SiteFoot from '../../../components/SiteFoot.astro';
import { CATEGORIES, getCatalogue } from '../../../lib/categories';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const works = await getCatalogue('en');
const groups = CATEGORIES.map((c, ci) => ({ c, n: ci + 2, items: works.filter((w) => w.cat === c).sort((a, b) => b.year - a.year) }));
const tail = CATEGORIES.length + 2;
---
<Base title="Giriş B — Inhalt">
  <Chrome here="selected" />
  <div class="below"></div>
  <section class="book">
    <div class="pre">
      <span class="label">Preface</span>
      <p>Studio No Frame is a spatial-experience research office. Whether designing an exhibition for a museum or building inside an artist’s practice, the studio treats every room as a question: what does this space do to the people who move through it? The answers are built, photographed and kept, project by project, since 2014, from Berlin and Istanbul.</p>
    </div>
    <div class="toc">
      <span class="label">Contents</span>
      <ol>
        <li class="top"><span class="n">1</span><a href={`${base}/about`}>Profile</a><span class="pg">Studio</span></li>
        {groups.map((g) => (<>
          <li class="top"><span class="n">{g.n}</span><span>{g.c.title}</span><span class="pg">{g.items.length}</span></li>
          {g.items.map((w, i) => <li class="sub"><span class="n">{g.n}.{i + 1}</span><a href={`${base}/projects/${w.id}`} data-img={`${base}${w.data.cover}`} data-cap={`${w.data.venue}, ${w.year}`}>{w.data.title}</a><span class="pg">{w.year}</span></li>)}
        </>))}
        <li class="top"><span class="n">{tail}</span><a href={`${base}/services`}>Services</a><span class="pg"></span></li>
        <li class="top"><span class="n">{tail + 1}</span><a href={`${base}/contact`}>Contact</a><span class="pg">Berlin</span></li>
      </ol>
    </div>
  </section>
  <figure class="fig peekfig" id="pf" aria-hidden="true"><img alt="" /><i></i><figcaption class="note"><span class="no"></span><span class="c"></span></figcaption></figure>
  <SiteFoot />
</Base>

<script is:inline>
(() => {
  const pf = document.getElementById('pf'); const img = pf.querySelector('img'); const no = pf.querySelector('.no'); const c = pf.querySelector('.c');
  document.querySelectorAll('.toc a[data-img]').forEach((a) => {
    a.addEventListener('pointerenter', () => { img.src = a.dataset.img; no.textContent = 'Fig. ' + a.closest('li').querySelector('.n').textContent; c.textContent = a.dataset.cap; pf.classList.add('on'); });
    a.addEventListener('pointerleave', () => pf.classList.remove('on'));
  });
})();
</script>

<style>
  .book { padding: clamp(1.5rem, 5vh, 3rem) var(--gutter) clamp(3rem, 7vw, 5rem); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 2rem clamp(2rem, 6vw, 7rem); align-items: start; }
  .label { display: block; margin-bottom: 0.9rem; }
  .pre p { margin: 0; font-size: clamp(1.15rem, 1.7vw, 1.55rem); line-height: 1.3; letter-spacing: -0.015em; }
  .pre { position: sticky; top: calc(var(--bar) + 1.5rem); }
  ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  li { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr) auto; gap: 0 1rem; align-items: baseline; padding: 0.45rem 0; border-bottom: 1px solid var(--rule); }
  li.top { padding-top: 1.1rem; font-weight: 600; font-stretch: 112%; font-size: clamp(1rem, 1.4vw, 1.25rem); letter-spacing: -0.02em; }
  li.sub { font-size: 0.95rem; }
  li.sub a { position: relative; }
  li.sub a::after { content: ''; position: absolute; left: 100%; right: -100vw; bottom: 0.25em; border-bottom: 1px dotted var(--rule); }
  .n { font-family: var(--mono); font-size: 0.7rem; color: var(--grey); }
  li.top .n { color: var(--ink); }
  .pg { font-family: var(--mono); font-size: 0.7rem; color: var(--grey); }
  li a:hover { color: var(--mark); }
  li.sub:hover .n { color: var(--mark); }
  .peekfig { position: fixed; right: var(--gutter); bottom: 3.5rem; width: min(26vw, 22rem); margin: 0; opacity: 0; transform: translateY(6px); transition: opacity 0.18s, transform 0.25s; pointer-events: none; z-index: 5; }
  .peekfig.on { opacity: 1; transform: none; }
  .peekfig img { aspect-ratio: 3/2; object-fit: cover; }
  .peekfig figcaption { margin-top: 0.5rem; }
  @media (max-width: 800px) { .book { grid-template-columns: 1fr; } .pre { position: static; } .peekfig { display: none; } }
</style>
