---
import Base from '../../../layouts/Base.astro';
import RHead from '../../../components/RHead.astro';
import RFoot from '../../../components/RFoot.astro';
import { getThreaded, THREADS } from '../../../lib/threads';
import '../../../styles/r-base.css';
import '../../../styles/r1.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const root = `${base}/designs/r1`;
const works = await getThreaded('en');
/* the opening drifts through one room per thread — the faces chosen in threads.ts */
const reel = [...THREADS].sort((a, b) => (a.key === 'archives' ? -1 : b.key === 'archives' ? 1 : 0)).map((t) => works.find((w) => w.id === t.face)!).filter(Boolean);
const caption = (w: (typeof works)[number]) => `№ ${w.no} — ${w.data.title}, ${w.data.venue}, ${w.data.year}`;
---

<Base title="Katalog" image={`${base}/images/og/default.jpg`}>
  <a class="escape" href={`${base}/designs/`}>Yönler</a>
  <RHead root={root} over current="works" />

  <section class="opening" id="opening">
    {reel.map((w, i) => (
      <img class={i === 0 ? 'is-on' : ''} src={`${base}${w.data.cover}`} alt={`${w.data.title} — ${w.data.venue}`} data-cap={caption(w)} data-href={`${root}/${w.id}`} fetchpriority={i === 0 ? 'high' : undefined} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
    ))}
    <div class="now">
      <a id="reel-cap" href={`${root}/${reel[0].id}`}>{caption(reel[0])}</a>
      <span class="count"><b id="reel-i">1</b> / {reel.length}</span>
      <span class="steps"><button type="button" id="reel-prev" aria-label="Previous room">←</button><button type="button" id="reel-next" aria-label="Next room">→</button></span>
    </div>
    <h1 class="say">Exhibitions as research.</h1>
    <a class="cue" href="#works">Works</a>
  </section>

  <section class="statement">
    <p>
      Studio No Frame builds exhibitions for museums, biennials and artists.
      <span>Each one starts as a question — about displacement, about what an
      archive can hold, about how a collection is read — and ends as a room
      people walk through. The catalogue below is arranged by those questions.</span>
    </p>
  </section>

  <div class="catalogue" id="works">
    <div class="list">
      <div class="filters" role="group" aria-label="Filter by thread">
        <button type="button" data-t="" aria-pressed="true">All</button>
        {THREADS.map((t, i) => <button type="button" data-t={t.key} aria-pressed="false">{i + 1}&nbsp; {t.title}</button>)}
      </div>

      <ol class="cat" id="cat">
        <li class="h">
          <span class="label">№</span><span class="label">Exhibition</span><span class="label">Venue</span><span class="label th">Thread</span><span class="label" style="text-align:right">Year</span>
        </li>
        {works.map((w) => (
          <li data-t={w.thread.key}>
            <a class="r" href={`${root}/${w.id}`} data-id={w.id} data-no={w.no} data-ttl={w.data.title} data-ven={w.data.venue}>
              <span class="no">{w.no}</span>
              <span class="ttl">{w.data.title}</span>
              <span class="ven">{w.data.venue}</span>
              <span class="th">{w.thread.title}</span>
              <span class="yr">{w.data.year}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <aside class="peek" aria-hidden="true">
      <div class="frame">
        {works.map((w, i) => (
          <img class={i === 0 ? 'is-on' : ''} data-id={w.id} src={`${base}${w.data.cover}`} alt="" loading="lazy" decoding="async" />
        ))}
      </div>
      <p class="cap"><span id="peek-no">{works[0].no}</span><span><b id="peek-ttl">{works[0].data.title}</b><span id="peek-ven">{works[0].data.venue}</span></span></p>
    </aside>
  </div>

  <RFoot />

  <script is:inline>
    /* the reel: one room after another, by itself while the opening is on
       screen, or by hand — arrows, keyboard, or a click on the photograph */
    (() => {
      const imgs = [...document.querySelectorAll('#opening img')];
      const cap = document.getElementById('reel-cap'), num = document.getElementById('reel-i');
      if (imgs.length < 2) return;
      let i = 0, timer;
      const go = (n) => {
        i = (n + imgs.length) % imgs.length;
        imgs.forEach((im, k) => im.classList.toggle('is-on', k === i));
        cap.textContent = imgs[i].dataset.cap;
        cap.href = imgs[i].dataset.href;
        num.textContent = i + 1;
      };
      const auto = () => {
        clearInterval(timer);
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = setInterval(() => { if (!document.hidden && window.scrollY < window.innerHeight) go(i + 1); }, 4500);
      };
      const hand = (n) => { go(n); auto(); };
      document.getElementById('reel-next').addEventListener('click', () => hand(i + 1));
      document.getElementById('reel-prev').addEventListener('click', () => hand(i - 1));
      imgs.forEach((im) => im.addEventListener('click', () => hand(i + 1)));
      window.addEventListener('keydown', (e) => {
        if (window.scrollY > window.innerHeight * 0.6) return;
        if (e.key === 'ArrowRight') hand(i + 1);
        if (e.key === 'ArrowLeft') hand(i - 1);
      });
      auto();
    })();

    /* the picture beside the table follows the row under the cursor */
    const peek = [...document.querySelectorAll('.peek img')];
    const pno = document.getElementById('peek-no'), pttl = document.getElementById('peek-ttl'), pven = document.getElementById('peek-ven');
    const show = (a) => {
      peek.forEach((im) => im.classList.toggle('is-on', im.dataset.id === a.dataset.id));
      pno.textContent = a.dataset.no; pttl.textContent = a.dataset.ttl; pven.textContent = a.dataset.ven;
    };
    document.querySelectorAll('#cat .r').forEach((a) => { a.addEventListener('mouseenter', () => show(a)); a.addEventListener('focus', () => show(a)); });

    const rows = [...document.querySelectorAll('#cat li[data-t]')];
    document.querySelectorAll('.filters button').forEach((b) => {
      b.addEventListener('click', () => {
        document.querySelectorAll('.filters button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        rows.forEach((li) => li.classList.toggle('is-hidden', !!b.dataset.t && li.dataset.t !== b.dataset.t));
        const first = rows.find((li) => !li.classList.contains('is-hidden'));
        if (first) show(first.querySelector('.r'));
      });
    });
  </script>
</Base>
