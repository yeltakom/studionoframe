---
import { render } from 'astro:content';
import SwissShell from '../../../layouts/SwissShell.astro';
import SwissBar from '../../../components/SwissBar.astro';
import { getRegister } from '../../../lib/register';
import accents from '../../../data/accents.json';
import '../../../styles/t-werkindex.css';

export async function getStaticPaths() {
  const entries = await getRegister();
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i - 1] ?? entries[entries.length - 1],
      next: entries[i + 1] ?? entries[0],
      more: entries
        .filter((o) => o.id !== entry.id && (o.data.venue === entry.data.venue || o.type === entry.type))
        .sort((a, b) => {
          const same = (x: typeof a) => (x.data.venue === entry.data.venue ? 0 : 1);
          return same(a) - same(b) || Number(a.nr) - Number(b.nr);
        })
        .slice(0, 4),
    },
  }));
}

const { entry, prev, next, more } = Astro.props;
const { Content } = await render(entry.entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { title, venue, year, role, images } = entry.data;
const [lead, ...rest] = images;
const seg = (accents as Record<string, string>)[entry.id] ?? '#111';
---

<SwissShell title={`${entry.nr} ${title} — Studio No Frame`}>
  <SwissBar right="nr" nr={entry.nr} />
  <div class="spectrum solid"><span style={`--seg:${seg}`}></span></div>

  {lead && (
    <div class="opener">
      <img src={`${base}${lead}`} alt={`${title} — ${venue}`} fetchpriority="high" decoding="async" />
    </div>
  )}

  <div class="record">
    <span class="nr">{entry.nr}</span>
    <h1>{title}</h1>
    <dl class="facts">
      <div><dt class="label">Venue</dt><dd>{venue}</dd></div>
      <div><dt class="label">City</dt><dd>{entry.city}</dd></div>
      <div><dt class="label">Year</dt><dd>{year}</dd></div>
      <div><dt class="label">Kind</dt><dd>{entry.type}</dd></div>
      <div><dt class="label">Role</dt><dd>{role}</dd></div>
    </dl>
  </div>

  <div class="note"><Content /></div>

  <div class="plates">
    {rest.map((src: string) => (
      <img src={`${base}${src}`} alt={`${title} — ${venue}`} loading="lazy" decoding="async" />
    ))}
  </div>

  {more.length > 0 && (
    <section class="more">
      <h2>{more[0].data.venue === venue ? 'Also at this venue' : 'Of the same kind'}</h2>
      <ul>
        {more.map((o) => (
          <li>
            <a href={`${base}/designs/werkindex/${o.id}`}>
              <span class="nr">{o.nr}</span>
              <span class="ttl">{o.data.title}</span>
              <span class="tag">{o.data.venue === venue ? o.data.year : o.data.venue}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <nav class="pager">
    <a href={`${base}/designs/werkindex/${prev.id}`}>
      <span class="dir">Previous {prev.nr}</span>
      <strong>{prev.data.title}</strong>
    </a>
    <a class="next" href={`${base}/designs/werkindex/${next.id}`}>
      <span class="dir">Next {next.nr}</span>
      <strong>{next.data.title}</strong>
    </a>
  </nav>
</SwissShell>
