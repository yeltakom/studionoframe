---
import SwissShell from '../../../layouts/SwissShell.astro';
import SwissBar from '../../../components/SwissBar.astro';
import { getRegister, facets } from '../../../lib/register';
import accents from '../../../data/accents.json';
import '../../../styles/t-werkindex.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const entries = await getRegister();
const { types, cities } = facets(entries);
const colour = (id: string) => (accents as Record<string, string>)[id] ?? '#111';
---

<SwissShell title="Studio No Frame">
  <SwissBar />

  <nav class="spectrum" aria-label="All exhibitions">
    {entries.map((e) => (
      <a href={`${base}/designs/werkindex/${e.id}`} style={`--seg:${colour(e.id)}`} aria-label={`${e.nr} ${e.data.title}`}></a>
    ))}
  </nav>

  <div class="facets">
    <button type="button" data-facet="type" data-value="" aria-pressed="true">All</button>
    {types.map(([name, n]) => (
      <button type="button" data-facet="type" data-value={name} aria-pressed="false">{name} <span>{n}</span></button>
    ))}
    <i class="sep"></i>
    {cities.map(([name, n]) => (
      <button type="button" data-facet="city" data-value={name} aria-pressed="false">{name} <span>{n}</span></button>
    ))}
  </div>

  <div class="register" id="register" data-view="werk">
    <div class="colhead">
      <button type="button" data-sort="nr" aria-sort="ascending">Nr</button>
      <button type="button" data-sort="ttl">Exhibition</button>
      <button type="button" data-sort="ven">Venue</button>
      <button type="button" data-sort="cty">City</button>
      <button type="button" data-sort="yr">Year</button>
      <button type="button" data-sort="knd">Kind</button>
    </div>

    {entries.map((e, i) => (
      <a
        class="entry"
        href={`${base}/designs/werkindex/${e.id}`}
        data-nr={e.nr}
        data-ttl={e.data.title}
        data-ven={e.data.venue}
        data-cty={e.city}
        data-yr={e.year}
        data-knd={e.type}
        data-role={e.data.role}
      >
        <img class="img" src={`${base}${e.data.cover}`} alt={`${e.data.title} — ${e.data.venue}`} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
        <span class="nr">{e.nr}</span>
        <span class="ttl">{e.data.title}</span>
        <span class="ven">{e.data.venue}</span>
        <span class="cty">{e.city}</span>
        <span class="yr">{e.data.year}</span>
        <span class="knd">{e.type}</span>
      </a>
    ))}

    <p class="empty" id="empty" hidden>Nothing matches that. Clear the search to see all nineteen.</p>
  </div>

  <script is:inline>
    const register = document.getElementById('register');
    const entries = [...register.querySelectorAll('.entry')];
    const input = document.getElementById('q');
    const count = document.getElementById('count');
    const empty = document.getElementById('empty');
    const state = { q: '', type: '', city: '', sort: 'nr', dir: 1 };

    const hay = (el) => [el.dataset.nr, el.dataset.ttl, el.dataset.ven, el.dataset.cty, el.dataset.yr, el.dataset.knd, el.dataset.role].join(' ').toLowerCase();

    const mark = (el) => {
      const node = el.querySelector('.ttl');
      const raw = el.dataset.ttl;
      const at = state.q ? raw.toLowerCase().indexOf(state.q) : -1;
      if (at < 0) { node.textContent = raw; return; }
      node.textContent = '';
      node.append(raw.slice(0, at), Object.assign(document.createElement('mark'), { textContent: raw.slice(at, at + state.q.length) }), raw.slice(at + state.q.length));
    };

    const apply = () => {
      let shown = 0;
      for (const el of entries) {
        const hit = (!state.q || hay(el).includes(state.q)) &&
          (!state.type || el.dataset.knd === state.type) &&
          (!state.city || el.dataset.cty === state.city);
        el.classList.toggle('is-hidden', !hit);
        if (hit) { shown++; mark(el); }
      }
      count.textContent = shown;
      empty.hidden = shown > 0;
    };

    input.addEventListener('input', () => { state.q = input.value.trim().toLowerCase(); apply(); });

    document.querySelectorAll('.facets button').forEach((b) => {
      b.addEventListener('click', () => {
        const facet = b.dataset.facet;
        state[facet] = state[facet] === b.dataset.value ? '' : b.dataset.value;
        document.querySelectorAll('.facets button').forEach((x) => {
          const isAll = x.dataset.facet === 'type' && x.dataset.value === '';
          x.setAttribute('aria-pressed', String(isAll ? !state.type : x.dataset.value === state[x.dataset.facet]));
        });
        apply();
      });
    });

    document.querySelectorAll('.colhead button').forEach((b) => {
      b.addEventListener('click', () => {
        const key = b.dataset.sort;
        state.dir = state.sort === key ? -state.dir : 1;
        state.sort = key;
        const val = (el) => (key === 'yr' || key === 'nr' ? Number(el.dataset[key]) : el.dataset[key].toLowerCase());
        [...entries].sort((x, y) => (val(x) < val(y) ? -1 : val(x) > val(y) ? 1 : 0) * state.dir).forEach((el) => register.appendChild(el));
        register.appendChild(empty);
        document.querySelectorAll('.colhead button').forEach((h) => {
          if (h.dataset.sort === key) h.setAttribute('aria-sort', state.dir === 1 ? 'ascending' : 'descending');
          else h.removeAttribute('aria-sort');
        });
      });
    });

    document.querySelectorAll('.bar nav button[data-view]').forEach((b) => {
      b.addEventListener('click', () => {
        register.dataset.view = b.dataset.view;
        document.querySelectorAll('.bar nav button[data-view]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        window.scrollTo({ top: 0 });
      });
    });

    /* plates arrive as they load rather than snapping in */
    const seen = new IntersectionObserver((rows) => {
      rows.forEach((r) => { if (r.isIntersecting) { r.target.classList.add('is-in'); seen.unobserve(r.target); } });
    }, { rootMargin: '200px' });
    register.querySelectorAll('.img').forEach((img) => seen.observe(img));

    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus(); input.select(); }
      if (e.key === 'Escape' && document.activeElement === input) { input.value = ''; state.q = ''; apply(); input.blur(); }
    });
  </script>
</SwissShell>
