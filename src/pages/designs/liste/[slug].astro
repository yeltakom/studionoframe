---
import { render } from 'astro:content';
import SwissShell from '../../../layouts/SwissShell.astro';
import { getRegister } from '../../../lib/register';
import '../../../styles/t-liste.css';

export async function getStaticPaths() {
  const entries = await getRegister();
  const order = [...entries].reverse();
  return order.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: order[i - 1] ?? order[order.length - 1], next: order[i + 1] ?? order[0] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry.entry);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { title, venue, year, role, images } = entry.data;
const [lead, ...rest] = images;
---

<SwissShell title={`${title} — Studio No Frame`}>
  <header class="head">
    <a class="studio" href={`${base}/designs/liste/`}>Studio No Frame</a>
    <span class="spacer"></span>
    <nav>
      <a href={`${base}/designs/liste/`}>Work</a>
      <a href={`${base}/about`}>About</a>
      <a href="mailto:contact@noframe.studio">Contact</a>
    </nav>
  </header>

  {lead && (
    <div class="opener">
      <img src={`${base}${lead}`} alt={`${title} — ${venue}`} fetchpriority="high" decoding="async" />
    </div>
  )}

  <div class="title-block">
    <span class="nr">{entry.nr}</span>
    <h1>{title}</h1>
    <dl>
      <div><dt class="label">Venue</dt><dd>{venue}</dd></div>
      <div><dt class="label">Year</dt><dd>{year}</dd></div>
      <div><dt class="label">Role</dt><dd>{role}</dd></div>
    </dl>
  </div>

  <div class="prose"><Content /></div>

  <div class="figures">
    {rest.map((src: string) => (
      <figure><img src={`${base}${src}`} alt={`${title} — ${venue}`} loading="lazy" decoding="async" /></figure>
    ))}
  </div>

  <nav class="pager">
    <a href={`${base}/designs/liste/${prev.id}`}>
      <span class="dir label">Previous</span>
      <strong>{prev.data.title}</strong>
    </a>
    <a class="next" href={`${base}/designs/liste/${next.id}`}>
      <span class="dir label">Next</span>
      <strong>{next.data.title}</strong>
    </a>
  </nav>
</SwissShell>
