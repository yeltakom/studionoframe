---
/* a frame for the design board: the home page in one graphic language (?t=), shown without storing it as the viewer's choice */
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---
<!doctype html>
<html><head><meta charset="utf-8" /><title>theme frame</title><style is:global>html,body,iframe{margin:0;width:100%;height:100%;border:0}</style></head>
<body><script is:inline define:vars={{ base }}>
  const t = new URLSearchParams(location.search).get('t') || '';
  const f = document.createElement('iframe'); f.src = `${base}/?theme=${t}&peek=1`; document.body.appendChild(f);
</script></body></html>
