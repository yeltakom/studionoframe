---
/* Index for the MYTH preview: the full list by category, no photographs, in motion. */
import Base from '../../../../layouts/Base.astro';
import SelHead from '../../../../components/SelHead.astro';
import SiteFoot from '../../../../components/SiteFoot.astro';
import IndexTable from '../../../../components/IndexTable.astro';
import { getCatalogue } from '../../../../lib/categories';
import { UI } from '../../../../i18n';

const t = UI.en;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const works = await getCatalogue('en');
const years = works.map((w) => w.year);
---
<Base lang="en" title="Index">
  <SelHead here="index" />
  <div class="below"></div>
  <header class="head">
    <h1>{t.index.title}</h1>
    <p>{t.index.line(works.length, Math.min(...years), Math.max(...years))}</p>
  </header>
  <IndexTable works={works} lang="en" root={`${base}/projects`} home={base} grouped peek={false} motion />
  <SiteFoot lang="en" />
</Base>
