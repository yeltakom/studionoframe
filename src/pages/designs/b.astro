---
import { getCollection } from 'astro:content';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import '../../styles/design-b.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const years = projects.flatMap((p) => (p.data.year.match(/\d{4}/g) ?? []).map(Number));

/* Rooms are laid out the way a plan is: a show with more to see gets a wider
   room, but a room never leaves a row half built — it shrinks to fit instead. */
let left = 12;
const rooms = projects.map((p) => {
  let span = p.data.images.length >= 9 ? 6 : 3;
  if (span > left) span = left;
  left -= span;
  if (left === 0) left = 12;
  return { p, span };
});
const remainder = left === 12 ? 12 : left;
---

<PreviewLayout title="Studio No Frame — Plan" variant="b" fonts="family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500">
  <div class="sheet">
    <div class="sheet-head">
      <p class="wordmark">Studio No Frame</p>
      <span>Exhibition architecture · Berlin</span>
      <nav>
        <a href="#plan">Work</a>
        <a href="#titleblock">About</a>
        <a href="mailto:contact@noframe.studio">Contact</a>
      </nav>
    </div>

    <div class="dimension" aria-hidden="true"></div>

    <p class="brief">
      <b>We design the rooms exhibitions happen in</b> — the sequence, the
      sightlines, the walls that get built and taken down again.{' '}
      <span>{projects.length} exhibitions with museums, biennials and artists,{' '}
      {Math.min(...years)}–{Math.max(...years)}. Each room below is one of them,
      sized by how much there is to show.</span>
    </p>

    <div class="plan" id="plan">
      {rooms.map(({ p, span }) => (
        <a class="room" style={`--span: ${span}`} href={`${base}/designs/b/${p.id}`}>
          <img src={`${base}${p.data.cover}`} alt={p.data.title} loading="lazy" />
          <span class="room-label">
            <b>{p.data.title}</b>
            <span>{p.data.venue} · {p.data.year}</span>
          </span>
        </a>
      ))}

      <dl class="titleblock-room" id="titleblock" style={`--span: ${remainder}`}>
        <div><dt>Studio</dt><dd>Studio No Frame</dd></div>
        <div><dt>Led by</dt><dd>Yelta Köm</dd></div>
        <div><dt>Based in</dt><dd>Berlin</dd></div>
        <div><dt>Contact</dt><dd><a href="mailto:contact@noframe.studio">contact@noframe.studio</a></dd></div>
      </dl>
    </div>
  </div>
</PreviewLayout>
