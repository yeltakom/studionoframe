---
import PreviewShell from '../../layouts/PreviewShell.astro';
import { getProjects } from '../../lib/projects';
import '../../styles/t-plakat.css';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const projects = await getProjects('en');
---

<PreviewShell title="Plakat · Register" variant="plakat-2">
  <header class="topbar">
    <a class="wordmark" href={`${base}/`}>Studio No Frame</a>
    <div class="register" id="register">
      {projects.map((p, i) => (
        <button type="button" data-go={i} aria-current={i === 0 ? 'true' : 'false'}>
          <b>{String(i + 1).padStart(2, '0')}</b> {p.data.title}
        </button>
      ))}
    </div>
    <a class="contact" href="mailto:contact@noframe.studio">Contact</a>
  </header>

  <div class="deck">
    {projects.map((p, i) => (
      <a class="poster" href={`${base}/projects/${p.id}`} data-index={i}>
        <img src={`${base}${p.data.cover}`} alt={`${p.data.title} — ${p.data.venue}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        <div class="sheet">
          <h2>{p.data.title}</h2>
          <p>{p.data.venue} · {p.data.year}<br />{p.data.role}</p>
        </div>
      </a>
    ))}

    <div class="end">
      <strong>Studio No Frame</strong>
      <p style="margin:0">Exhibition architecture, production and curation. Berlin.</p>
      <p style="margin:0"><a href="mailto:contact@noframe.studio">contact@noframe.studio</a></p>
    </div>
  </div>

  <style>
    /* the menu is the register of shows: all nineteen, scrolling with you */
    .register {
      flex: 1;
      display: flex;
      gap: 0.9rem;
      overflow-x: auto;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 1.5rem), transparent);
    }
    .register::-webkit-scrollbar { display: none; }
    .register button {
      appearance: none;
      border: 0;
      background: none;
      padding: 0.2rem 0;
      font: inherit;
      font-size: 0.7rem;
      letter-spacing: 0.01em;
      color: rgba(255, 255, 255, 0.5);
      white-space: nowrap;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      transition: color 160ms ease;
    }
    .register button b { font-weight: 400; opacity: 0.6; }
    .register button:hover { color: #fff; }
    .register button[aria-current='true'] { color: #fff; border-bottom-color: #fff; }
    .contact { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.72; white-space: nowrap; }
    .contact:hover { opacity: 1; }
    @media (max-width: 640px) { .contact { display: none; } }
  </style>

  <script is:inline>
    const posters = [...document.querySelectorAll('.poster')];
    const buttons = [...document.querySelectorAll('.register button')];
    const strip = document.getElementById('register');

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        posters[Number(b.dataset.go)].scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    const observer = new IntersectionObserver((entries) => {
      const top = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!top) return;
      const i = Number(top.target.dataset.index);
      buttons.forEach((b, n) => b.setAttribute('aria-current', String(n === i)));
      const active = buttons[i];
      if (active) {
        const left = active.offsetLeft - strip.clientWidth / 2 + active.clientWidth / 2;
        strip.scrollTo({ left, behavior: 'smooth' });
      }
    }, { threshold: [0.3, 0.6, 0.9] });

    posters.forEach((p) => observer.observe(p));
  </script>
</PreviewShell>
