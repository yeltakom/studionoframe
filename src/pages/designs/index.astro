---
import { getProjects } from '../../lib/projects';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const projects = await getProjects('en');
const sample = projects[12]; // Vardiya — orta uzunlukta metin, 8 fotoğraf

/* the candidates for the final decision, each shown live in a small frame */
const board = [
  { href: '/', name: 'Selected', tag: 'Yayında', line: 'MYTH yapısı: bir cümle, dönen büyük fotoğraf, kategoriye göre süzülen ızgara. Index tek liste, Type sütunlu; ayrıca Profile, Services, Contact.' },
  { href: '/designs/akis/', name: 'Akış', tag: '25 Eylül', line: 'Saraceno mantığı: kapak, numara, başlık, künye alt alta; en yeni üstte. "Açılış sayfası güzel" dediğin.' },
  { href: '/designs/kartothek/', name: 'Kartothek', tag: '11 Ekim', line: 'Arc UI ile: ⌘K arama, çip filtreleri, sıralanan tablo, yanda oda. Archivo + IBM Plex Mono.' },
  { href: '/designs/kabinett/', name: 'Kabinett', tag: '11 Ekim', line: 'Arc UI ile: koyu zemin, 19 sergi bir deste kart; savurarak geziliyor. Instrument Serif + Inter.' },
  { href: '/designs/hybrid/', name: 'Afiş + şerit', tag: 'Hybrid', line: 'Tek büyük kare, altında bütün karelerin şeridi; şeritte gezdikçe afiş değişiyor.' },
  { href: '/designs/liste/', name: 'Liste', tag: 'Checklist', line: 'Sevdiğin tipografik liste, kalıcı numaralar, sağ yarıda büyük imaj.' },
  { href: '/designs/werkindex/', name: 'Werkindex', tag: 'HdM', line: 'Herzog & de Meuron kütüğü: 001–019, arama, sıralama, tür ve şehir filtresi.' },
  { href: '/designs/plakat-3/', name: 'Plakat 3', tag: 'Afiş', line: 'Her sergi tam ekran bir afiş; onayladığın proje sayfasının ilk hâli buradan.' },
];

const themes = [
  { key: 'katalog', name: 'Katalog', pitch: 'Oxblood zemin, altın çizgiler, kağıt dokusu. Bodoni Moda + EB Garamond — bir müze kataloğunun kapağı. Metin sayfasında ilk harf altın drop-cap.', tone: 'Koyu · serif · sakin lüks' },
  { key: 'bauplan', name: 'Bauplan', pitch: 'Prusya mavisi zemin, altında milimetrik çizim ızgarası, camgöbeği çizgiler ve turuncu işaretler. Big Shoulders + Martian Mono. Açılışta başlık soldan sağa çiziliyor.', tone: 'Koyu · teknik · mühendislik' },
  { key: 'saal', name: 'Saal', pitch: 'Beyaz değil: müze duvarının soğuk sıva grisi. Tek doygun kobalt her şeyi işaretliyor. Bricolage Grotesque + Newsreader.', tone: 'Açık · editoryal · kobalt' },
  { key: 'nacht', name: 'Nacht', pitch: 'Siyah zemin, magenta ve limon yeşili, halftone nokta dokusu, üstte kayan şerit. Unbounded + Kode Mono — Berlin afişi. Satıra gelince fotokopi gibi bir kare beliriyor.', tone: 'Siyah · yüksek sesli · afiş' },
];

/* uiarc.dev (Arc UI) ile kurulan iki deneme. Arc hazır React bileşenleri
   veriyor — komut paleti, çip filtresi, sıralanabilir tablo, kart destesi,
   imaj karşılaştırma — ve hepsi kendi hareketiyle geliyor. Bu iki sayfa React
   adası kullanan tek yer; sitenin kalanı sade Astro. */
const arc = [
  {
    key: 'kartothek',
    name: 'Kartothek',
    pitch: 'Kütük bu kez gerçekten çalışıyor: ⌘K (ya da “/”) ile komut paleti açılıp 19 serginin içinde arama yapıyor, çiplerle mekân türüne ve şehre göre süzülüyor, sütun başlıklarından sıralanıyor, satıra gelince sağdaki kare o odaya dönüyor. Sayaç filtre değişince yeni sayıya dönüyor. Proje sayfasında plakalar sürüklenen bir şeritte.',
    note: 'Açık · arşiv kağıdı · Archivo + IBM Plex Mono. Arc: command palette, chip group, segmented control, sortable table, badge, slot text, dialog, carousel.',
  },
  {
    key: 'kabinett',
    name: 'Kabinett',
    pitch: 'Arşiv sana tek tek uzatılıyor: 19 sergi bir deste; kartı sola savurursan sıradaki geliyor, sağa savurursan o odaya giriyorsun. Üstte başlık satır satır açılıyor. Proje sayfasında aynı kurulumun ilk ve son plakası tek çerçevede, aralarındaki sürgüyü çekerek okuyorsun.',
    note: 'Koyu · fotoğraf önde · Instrument Serif + Inter. Arc: card stack, in-view title, image compare, carousel, segmented control, slot text, badge.',
  },
];

const full = [
  { key: 'werkindex/', name: 'Werkindex', pitch: 'Herzog & de Meuron mantığı: her serginin kalıcı bir numarası var — 001 Disobedience Archive (2014) → 019 Tirailleurs (2026) — ve site aslında o kütük. Canlı arama (“/” tuşu), sütun başlıklarından sıralama, tür ve şehir filtreleri, liste ⇄ plaka görünümü, satıra gelince köşede beliren kare. Proje sayfasında çapraz referanslar: aynı mekândaki ya da aynı türdeki diğer işler.', note: 'Tam site: indeks + proje sayfaları + Practice. Familjen Grotesk + Fragment Mono, arşiv kırmızısı.' },
  { key: 'plakat-3', name: 'Plakat · Tafel', pitch: 'Tam ekran afiş destesi, sağ üstte “Index” düğmesi; basınca 19 sergi kademeli açılıyor. Proje sayfası da aynı dünyada: tam ekran açılış karesi, üstünde başlık, altında plakalar.', note: 'Tam site: afiş destesi + proje sayfaları.' },
  { key: 'hybrid', name: 'Plakat × Kontaktbogen', pitch: 'Üstte tek kare afiş boyunda, altında 135 karenin kayan kontakt şeridi; şeritte gezindikçe afiş değişiyor. Kareye tıklayınca Tafel proje sayfası açılıyor.', note: 'Tam site: hibrit indeks + proje sayfaları.' },
];

const shortlist = [
  { key: 'plakat-1', name: 'Plakat · Leiste', idea: 'Üstte sabit ince bir çubuk: stüdyo adı, menü ve sağda “03 / 19 — Vardiya” sayacı. Çubuğun altındaki saç teli çizgi destenin neresinde olduğunu gösteriyor.', note: 'En sade menü. Afişler bozulmuyor.' },
  { key: 'plakat-2', name: 'Plakat · Register', idea: 'Menünün kendisi sergi listesi: 19 başlık üst çubukta yatay bir şerit hâlinde. Kaydırdıkça o anki başlık beyazlaşıp şerit kendini ortalıyor; tıklayınca o afişe gidiyor.', note: 'Menü + içindekiler tek şeritte.' },
  { key: 'plakat-3', name: 'Plakat · Tafel', idea: 'Sağ üstte “Index” düğmesi; basınca 19 serginin tamamı afişin üstüne tam ekran bir panel olarak kademeli açılıyor. Esc ile kapanıyor.', note: 'Menü gizli, açılınca gösterişli.' },
  { key: 'kontakt-1', name: 'Kontaktbogen · Kopf', idea: 'Üstte gerçek bir menü çubuğu, hemen altında yapışkan filtre şeridi ve sağda kaç kare gösterildiğini sayan bir gösterge.', note: 'Beğendiğin föyün düzgün menülü hâli.' },
  { key: 'kontakt-2', name: 'Kontaktbogen · Rollen', idea: 'Kareler sergiye göre “rulolara” ayrılmış: her serginin kendi yapışkan başlığı var, solda hangi ruloda olduğunu işaretleyen bir künye rayı.', note: 'Arşiv gibi; 135 kare içinde kaybolmuyorsun.' },
  { key: 'hybrid', name: 'Plakat × Kontaktbogen', idea: 'İkisinin karışımı, deneysel: üstte tek kare afiş boyunda, altında bütün 135 karenin kayan kontakt şeridi. Şeritte hangi kareye gelirsen afiş ona dönüyor; tekerlek, ok tuşları veya afişe tıklamak kare kare ilerletiyor.', note: 'Afişin ölçeği + föyün bütünü tek ekranda.' },
  { key: 'kontakt-3', name: 'Kontaktbogen · Dicht', idea: 'Çok daha sık ve kare formatlı bir föy. Üstte sıralama (portfolyo / yıl / mekân) ve kare boyutunu değiştiren bir sürgü; künyeler sadece üstüne gelince çıkıyor.', note: 'En yoğun. Fotoğraf arşivi hissi.' },
];

const groups = [
  {
    heading: 'Sakin — okunaklılık önde',
    items: [
      { key: 'f', name: 'Index & Ansicht', idea: 'Solda 19 serginin listesi, sağda büyük bir görüntü. Listede hangi satıra gelirsen sağdaki görüntü ona dönüyor; okumak ve bakmak aynı anda oluyor.', note: 'İyi ofis sitelerinin en çok kullandığı kurgu. Yayındaki listenin doğal büyümüş hâli.' },
      { key: 'd', name: 'Fassade', idea: 'Solda sabit künye sütunu, sağda işler akıyor; kaydırdıkça soldaki künye kendini yeniden yazıyor.', note: 'En sakin. İsviçre ofislerinin tavrı.' },
      { key: 'c', name: 'Kontaktbogen', idea: 'Bütün kareler numaralı bir kontakt föyünde, üstte sergi adlarından filtre şeridi.', note: 'Arşiv mantığı, hızlı süzme.' },
    ],
  },
  {
    heading: 'Gösterişli — fotoğraf önde',
    items: [
      { key: 'e', name: 'Korridor', idea: 'İşler yatay bir koridorda diziliyor; tekerlek, sürükleme veya ok tuşlarıyla içinde yürüyorsun. Altta ne kadar ilerlediğini gösteren ince bir çizgi.', note: 'Sergi gezmeye en çok benzeyen gezinme.' },
      { key: 'a', name: 'Mosaik', idea: 'Bütün fotoğraflar kenardan kenara döşeli, üstünde devasa daktilo tipografiyle stüdyo adı — hangi kareye gelirsen o serginin rengini alıyor.', note: 'Tanja Lincke referansına en yakın.' },
      { key: 'b', name: 'Plakat', idea: 'Her sergi tam ekran bir afiş, başlık fotoğrafın içinde, künye siyah çipte.', note: 'En yüksek sesli.' },
    ],
  },
  {
    heading: 'Deneysel — yeni teknoloji',
    items: [
      { key: 'g', name: 'Fluss · WebGL', idea: 'Fotoğrafları tarayıcı değil ekran kartı çiziyor: her kare bir doku düzlemi ve kaydırma hızıyla bükülüyor, durunca düzleşiyor.', note: 'WebGL yoksa ya da “az hareket” açıksa sayfa normal fotoğraflara düşüyor — kırılmıyor.' },
      { key: 'h', name: 'Raum · sonsuz düzlem', idea: 'Sayfa değil oda: 135 fotoğrafın tamamı tek bir açık düzleme serilmiş. Sürükleyerek geziyorsun, ⌃+tekerlekle yaklaşıp uzaklaşıyorsun.', note: 'Bir kurulumun açılıştan bir hafta önceki hâli gibi.' },
    ],
  },
];

const inners = [
  { key: 'p1', name: 'Sequenz', idea: 'Metin üstte, sonra fotoğraflar boşluksuz alt alta tam genişlikte; altta sayfayla birlikte kayan ince bir künye şeridi.' },
  { key: 'p2', name: 'Dossier', idea: 'Solda sabit bir dosya sütunu (künye + metin), sağda plakalar akıyor. Metin hep göz önünde kalıyor.' },
  { key: 'p3', name: 'Galerie', idea: 'Tam ekran tek kare, altta küçük görsel şeridi; ok tuşları veya tıklamayla kare kare ilerliyorsun.' },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>Studio No Frame — tasarım yönleri</title>
    <style is:inline>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0; background: #fff; color: #111;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        font-size: 1rem; line-height: 1.6; letter-spacing: -0.006em;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 70rem; margin: 0 auto; padding: clamp(2rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) 5rem; }
      h1 { font-size: clamp(1.5rem, 3.5vw, 2.4rem); font-weight: 700; letter-spacing: -0.03em; margin: 0 0 0.75rem; }
      .lede { max-width: 64ch; color: #6f6f6f; margin: 0 0 clamp(2rem, 5vw, 3.5rem); }
      h2.group { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8d8d8d; margin: clamp(2rem, 5vw, 3rem) 0 0; }
      .opt { border-top: 1px solid #111; padding: clamp(1.25rem, 2.5vw, 1.75rem) 0; display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 7rem; gap: 0.75rem clamp(1rem, 3vw, 2.5rem); align-items: start; }
      .key { font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8d8d8d; padding-top: 0.2rem; }
      h3 { margin: 0 0 0.4rem; font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; }
      p { margin: 0 0 0.5rem; }
      .note { font-size: 0.82rem; color: #8d8d8d; margin: 0; }
      .go { display: inline-block; background: #111; color: #fff; text-decoration: none; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.5rem 0.8rem; }
      .go.ghost { background: none; color: #111; border: 1px solid #d7d7d7; }
      .foot { border-top: 1px solid #111; margin-top: 2rem; padding-top: 1.25rem; color: #6f6f6f; max-width: 64ch; }
      @media (max-width: 720px) { .opt { grid-template-columns: 1fr; } }
          .board { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 2rem 1.5rem; margin-top: 1rem; }
      .card { display: block; color: inherit; text-decoration: none; }
      .card .shot { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid #ddd; background: #f4f4f4; }
      .card iframe { position: absolute; top: 0; left: 0; width: 1440px; height: 900px; border: 0; transform: scale(var(--k, 0.25)); transform-origin: 0 0; pointer-events: none; }
      .card .meta { display: flex; align-items: baseline; gap: 0.6rem; margin-top: 0.6rem; }
      .card .meta b { font-size: 1.05rem; }
      .card .tag { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: #888; }
      .card .line { display: block; margin-top: 0.2rem; font-size: 0.86rem; line-height: 1.4; color: #555; }
      .card:hover .shot { border-color: #111; }
      .card:hover b { text-decoration: underline; text-underline-offset: 0.15em; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>Tasarım yönleri</h1>
      <p class="lede">
        Son karar için: en üstte sekiz aday, her biri canlı, küçük bir çerçevede.
        Tıklayınca tam sayfa açılıyor. Hepsi aynı gerçek içerikle — 19 proje,
        135 fotoğraf. Altta bütün eski denemeler arşiv olarak duruyor.
      </p>

      <h2 class="group">Grafik dil — aynı strüktür, dört deneme</h2>
      <p class="lede">Yapı sabit; yalnızca renk, yazı ve tek bir imza değişiyor. Tıklayınca site o dille açılır ve sen kapatana kadar öyle kalır (sol altta küçük anahtar var).</p>
      <div class="board">
        {[
          { k: 'spektrum', name: 'Spektrum', line: 'Siyah kâğıt, beyaz yazı; başlıklar geniş Unbounded. İmza: Instagram avatarındaki tayf, menünün altında akan iki piksellik çizgi; seçili menü, nokta ve hover çizgisi hep o tayf.' },
          { k: 'weiss', name: 'Spektrum Weiß', line: 'Spektrum’un beyaz kâğıtta hâli: siyah Unbounded başlıklar; sayfadaki her siyah çizgi tayf oldu — menü altı, Index başlığı, künye, altbilgi, hover, seçili filtre, fotoğraf kartının altı.' },
          { k: 'infrarot', name: 'Infrarot', line: 'Koyu mor zemin, sıcak sarı büyük harf Chakra Petch (OUTPUT paylaşımındaki ses). İmza: her fotoğraf soğuk termal plaka olarak gelir, üzerine gelince renklenir.' },
          { k: 'raster', name: 'Raster', line: 'Gri kâğıt, riso yeşili, noktalı çizgiler. İmza: başlıklar nokta matrisi Doto ile, MERRY CRISIS fanzini gibi basılmış.' },
        ].map((b) => (
          <a class="card" href={`${base}/?theme=${b.k}`}>
            <span class="shot"><iframe src={`${base}/designs/theme/?t=${b.k}`} loading="lazy" tabindex="-1" aria-hidden="true" title={b.name}></iframe></span>
            <span class="meta"><b>{b.name}</b><span class="tag">29 Ekim</span></span>
            <span class="line">{b.line}</span>
          </a>
        ))}
      </div>

      <h2 class="group" style="margin-top:4rem">Son karar — sekiz aday</h2>
      <div class="board">
        {board.map((b) => (
          <a class="card" href={`${base}${b.href}`}>
            <span class="shot"><iframe src={`${base}${b.href}`} loading="lazy" tabindex="-1" aria-hidden="true" title={b.name}></iframe></span>
            <span class="meta"><b>{b.name}</b><span class="tag">{b.tag}</span></span>
            <span class="line">{b.line}</span>
          </a>
        ))}
      </div>
      <script is:inline>
        /* each frame shows the page at 1440 px wide, scaled down to the card */
        const fit = () => document.querySelectorAll('.board .shot').forEach((s) => s.style.setProperty('--k', s.clientWidth / 1440));
        fit(); addEventListener('resize', fit);
      </script>

      <h2 class="group" style="margin-top:4rem">Arşiv — bütün denemeler</h2>

      <h2 class="group">Yeni — Arc UI (uiarc.dev) ile iki deneme</h2>
      {arc.map((o) => (
        <div class="opt">
          <span class="key">{o.name}</span>
          <div>
            <h3>{o.name}</h3>
            <p>{o.pitch}</p>
            <p class="note">{o.note}</p>
          </div>
          <a class="go" href={`${base}/designs/${o.key}/`}>Aç</a>
        </div>
      ))}

      <h2 class="group">En son — sevdiğin listenin büyümüş hâli</h2>
      <div class="opt">
        <span class="key">Liste</span>
        <div>
          <h3>Liste</h3>
          <p>Beğendiğin checklist aynen duruyor — aynı tipografi, aynı sakinlik — ama sağ yarısını tek bir büyük imaja veriyor: listede hangi satıra gelirsen o odayı görüyorsun. Kalıcı numaralar (019 → 001) ve arama eklendi. Proje sayfası tam genişlikte fotoğrafla açılıyor.</p>
          <p class="note">Yeni bir yön değil; çalışan tasarımın üstüne senin istediklerin.</p>
        </div>
        <a class="go" href={`${base}/designs/liste/`}>Aç</a>
      </div>

      <h2 class="group">Tam siteler — indeks + proje sayfaları birlikte</h2>
      {full.map((o) => (
        <div class="opt">
          <span class="key">{o.name.split(' · ')[0]}</span>
          <div>
            <h3>{o.name}</h3>
            <p>{o.pitch}</p>
            <p class="note">{o.note}</p>
          </div>
          <a class="go" href={`${base}/designs/${o.key}`}>Aç</a>
        </div>
      ))}

      <h2 class="group">Yeni — Plakat ve Kontaktbogen’in üst menülü varyasyonları</h2>
      {shortlist.map((o) => (
        <div class="opt">
          <span class="key">{o.name.split(' · ')[1]}</span>
          <div>
            <h3>{o.name}</h3>
            <p>{o.idea}</p>
            <p class="note">{o.note}</p>
          </div>
          <a class="go" href={`${base}/designs/${o.key}`}>Aç</a>
        </div>
      ))}

      <h2 class="group">Tam kimlikler — kendi yazı tipi, rengi, dokusu ve açılışı</h2>
      {themes.map((o) => (
        <div class="opt">
          <span class="key">{o.name}</span>
          <div>
            <h3>{o.name}</h3>
            <p>{o.pitch}</p>
            <p class="note">{o.tone} · ana sayfa + proje sayfası birlikte</p>
          </div>
          <a class="go" href={`${base}/designs/${o.key}/`}>Aç</a>
        </div>
      ))}

      {groups.map((group) => (
        <>
          <h2 class="group">{group.heading}</h2>
          {group.items.map((o) => (
            <div class="opt">
              <span class="key">Yön {o.key.toUpperCase()}</span>
              <div>
                <h3>{o.name}</h3>
                <p>{o.idea}</p>
                <p class="note">{o.note}</p>
              </div>
              <a class="go" href={`${base}/designs/${o.key}`}>Aç</a>
            </div>
          ))}
        </>
      ))}

      <h2 class="group">İç sayfa (proje sayfası) alternatifleri</h2>
      {inners.map((o) => (
        <div class="opt">
          <span class="key">{o.key.toUpperCase()}</span>
          <div>
            <h3>{o.name}</h3>
            <p>{o.idea}</p>
            <p class="note">Örnek: {sample.data.title}. Açtığın sayfanın üstünden diğer ikisine geçebilirsin.</p>
          </div>
          <a class="go" href={`${base}/designs/${o.key}/${sample.id}`}>Aç</a>
        </div>
      ))}

      <p class="foot">
        Kararını adıyla söyle — örneğin “Index” ya da “Akış ana sayfa, Index
        proje sayfası”. Onu yayına alır, kalanları silerim.
      </p>
    </div>
  </body>
</html>
