---
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const sample = projects[12];   // Vardiya — orta uzunlukta metin, çok görsel

const options = [
  {
    key: 'a',
    name: 'Checklist',
    idea: 'Ana sayfa bir sergi listesi: yıl, başlık, mekân, rol. Fotoğraf yok — satırın üstüne gelince o serginin fotoğrafı imlecin yanında beliriyor.',
    why: 'Bir küratör bir stüdyoyu önce nerede, ne zaman, hangi rolle çalıştığına bakarak okur. Liste bunu ilk saniyede veriyor.',
    type: 'Archivo Condensed (versal) + IBM Plex Mono',
  },
  {
    key: 'b',
    name: 'Plan',
    idea: 'Sayfa bir çizim paftası: projeler farklı büyüklükte “odalar” olarak bir ızgaraya diziliyor, kenarda ölçü taramaları, altta çizim antedi. Fotoğraflar gri, üstüne gelince renkleniyor.',
    why: 'Stüdyonun ürettiği ilk şey oda değil, çizim. Sayfa da öyle davranıyor.',
    type: 'Archivo + IBM Plex Mono',
  },
  {
    key: 'c',
    name: 'Vitrine',
    idea: 'Sessiz ve geniş: her sergi tek başına, büyük, sola–sağa kayarak akıyor. Tek yüksek sesli öğe stüdyonun adı.',
    why: 'Sergi gezer gibi aşağı iniyorsun; işler nefes alıyor, tipografi kenara çekiliyor.',
    type: 'Syne (sanat kurumları için çizilmiş) + Archivo',
  },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <title>Studio No Frame — üç tasarım yönü</title>
    <style is:inline>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        margin: 0; background: #fff; color: #111;
        font-family: 'Archivo', Helvetica, Arial, sans-serif;
        font-size: 1rem; line-height: 1.6; -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 68rem; margin: 0 auto; padding: clamp(2rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) 5rem; }
      h1 { font-size: clamp(1.5rem, 3.5vw, 2.4rem); font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.75rem; }
      .lede { max-width: 60ch; color: #6f6f6f; margin: 0 0 clamp(2rem, 5vw, 3.5rem); }
      .opt { border-top: 1px solid #111; padding: clamp(1.5rem, 3vw, 2.25rem) 0; display: grid; grid-template-columns: 7rem minmax(0, 1fr) minmax(0, 15rem); gap: 1rem clamp(1rem, 3vw, 2.5rem); }
      .key { font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: #8d8d8d; }
      h2 { margin: 0 0 0.5rem; font-size: 1.3rem; font-weight: 600; letter-spacing: -0.01em; }
      p { margin: 0 0 0.75rem; }
      .why { color: #6f6f6f; }
      .type { font-family: 'IBM Plex Mono', monospace; font-size: 0.72rem; color: #8d8d8d; letter-spacing: 0.02em; }
      .links { display: flex; flex-direction: column; gap: 0.5rem; align-items: start; }
      .links a { font-family: 'IBM Plex Mono', monospace; font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; color: #111; border-bottom: 1px solid #d7d7d7; padding-bottom: 2px; }
      .links a:hover { border-bottom-color: #111; }
      .links a.primary { background: #111; color: #fff; border: 0; padding: 0.55rem 0.85rem; }
      .foot { border-top: 1px solid #111; padding-top: 1.25rem; color: #6f6f6f; font-size: 0.9rem; max-width: 60ch; }
      @media (max-width: 720px) { .opt { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <div class="wrap">
      <h1>Üç tasarım yönü</h1>
      <p class="lede">
        Üçü de tam beyaz, üçü de senin gerçek içeriğinle çalışıyor — 19 serginin
        tamamı, kendi fotoğrafları ve metinleriyle. Gez, birini seç; seçtiğini
        sitenin asıl tasarımı yapıp diğerlerini siliyorum.
      </p>

      {options.map((o) => (
        <div class="opt">
          <span class="key">Yön {o.key.toUpperCase()}</span>
          <div>
            <h2>{o.name}</h2>
            <p>{o.idea}</p>
            <p class="why">{o.why}</p>
            <p class="type">{o.type}</p>
          </div>
          <div class="links">
            <a class="primary" href={`${base}/designs/${o.key}`}>Ana sayfayı aç</a>
            <a href={`${base}/designs/${o.key}/${sample.id}`}>Proje sayfası →</a>
          </div>
        </div>
      ))}

      <div class="opt" style="grid-template-columns: 7rem minmax(0,1fr) minmax(0,15rem)">
        <span class="key">Şu anki</span>
        <div>
          <h2>Spectrum</h2>
          <p>Şu an yayında olan tasarım: beyaz değil, kırık beyaz zemin; her serginin rengi kendi fotoğrafından örneklenip üstteki renk şeridini oluşturuyor.</p>
          <p class="why">Karşılaştırman için burada duruyor.</p>
        </div>
        <div class="links">
          <a href={`${base}/`}>Ana sayfayı aç</a>
          <a href={`${base}/projects/${sample.id}`}>Proje sayfası →</a>
        </div>
      </div>

      <p class="foot">
        Karar verirken şuna bak: sergi fotoğrafların mı öne çıksın, yoksa kurumsal
        listen mi? A listeyi, C fotoğrafı, B ikisinin arasını tutuyor.
      </p>
    </div>
  </body>
</html>
