---
import { getCollection } from 'astro:content';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import '../../styles/design-a.css';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<PreviewLayout title="Studio No Frame — Checklist" variant="a" fonts="family=Archivo:wdth,wght@62..125,400..700&family=IBM+Plex+Mono:wght@400;500">
  <header class="masthead">
    <a class="wordmark" href={`${base}/designs/a`}>Studio<br />No Frame</a>
    <nav>
      <a href="#checklist">Work</a>
      <a href="#colophon">About</a>
      <a href="mailto:contact@noframe.studio">Contact</a>
    </nav>
  </header>

  <p class="standfirst">
    <strong>Exhibition architecture, production and curation, from Berlin.</strong>{' '}
    Nineteen shows built with museums, biennials and artists since 2014. Hover a
    line to see the room it became.
  </p>

  <div class="checklist-head" id="checklist">
    <span>Year</span><span>Exhibition</span><span>Venue</span><span>Role</span>
  </div>

  <ol class="checklist">
    {projects.map((p) => (
      <li>
        <a class="row" href={`${base}/designs/a/${p.id}`} data-peek={`${base}${p.data.cover}`}>
          <span class="year">{p.data.year}</span>
          <span class="title">{p.data.title}</span>
          <span class="venue">{p.data.venue}</span>
          <span class="role">{p.data.role}</span>
          <img class="thumb-inline" src={`${base}${p.data.cover}`} alt="" loading="lazy" />
        </a>
      </li>
    ))}
  </ol>

  <div class="colophon" id="colophon">
    <span>Studio No Frame · Berlin</span>
    <span>contact@noframe.studio</span>
  </div>

  <img class="peek" alt="" aria-hidden="true" />

  <script is:inline>
    const peek = document.querySelector('.peek');
    const rows = document.querySelectorAll('.row[data-peek]');
    let raf = 0;
    const move = (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        peek.style.left = e.clientX + 'px';
        peek.style.top = e.clientY + 'px';
      });
    };
    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => {
        peek.src = row.dataset.peek;
        peek.classList.add('is-visible');
        window.addEventListener('mousemove', move);
      });
      row.addEventListener('mouseleave', () => {
        peek.classList.remove('is-visible');
        window.removeEventListener('mousemove', move);
      });
    });
  </script>
</PreviewLayout>
