---
import PreviewShell from '../../../layouts/PreviewShell.astro';
import InnerSwitcher from '../../../components/InnerSwitcher.astro';
import { getProjects } from '../../../lib/projects';
import '../../../styles/inner.css';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[i + 1] ?? projects[0] },
  }));
}

const { project, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const { title, venue, year, role, images, summary } = project.data;
---

<PreviewShell title={`${title} — Galerie`} variant="p3">
  <InnerSwitcher slug={project.id} current="p3" />

  <div class="p3">
    <p class="caption"><span id="frameNo">01</span> / {String(images.length).padStart(2, '0')} — {summary.slice(0, 90)}</p>

    <div class="stage">
      {images.map((src: string, i: number) => (
        <img
          src={`${base}${src}`}
          alt={`${title} — ${venue}, ${i + 1}`}
          class={i === 0 ? 'is-active' : undefined}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
        />
      ))}
    </div>

    <div class="bar">
      <div class="top">
        <h1>{title}</h1>
        <span class="meta">{venue} · {year} — {role}</span>
        <a class="meta" href={`${base}/designs/p3/${next.id}`}>Next: {next.data.title} →</a>
      </div>
      <div class="thumbs">
        {images.map((src: string, i: number) => (
          <button type="button" data-index={i} aria-current={i === 0 ? 'true' : 'false'} aria-label={`Frame ${i + 1}`}>
            <img src={`${base}${src}`} alt="" loading="lazy" decoding="async" />
          </button>
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    const shots = [...document.querySelectorAll('.stage img')];
    const buttons = [...document.querySelectorAll('.thumbs button')];
    const frameNo = document.getElementById('frameNo');
    let index = 0;

    const show = (next) => {
      index = (next + shots.length) % shots.length;
      shots.forEach((s, i) => s.classList.toggle('is-active', i === index));
      buttons.forEach((b, i) => b.setAttribute('aria-current', String(i === index)));
      frameNo.textContent = String(index + 1).padStart(2, '0');
      buttons[index].scrollIntoView({ block: 'nearest', inline: 'center' });
    };

    buttons.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.index))));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
    });
    document.querySelector('.stage').addEventListener('click', () => show(index + 1));
  </script>
</PreviewShell>
