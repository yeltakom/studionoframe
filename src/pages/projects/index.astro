---
import Base from '../../layouts/Base.astro';
import Chrome from '../../components/Chrome.astro';
import SiteFoot from '../../components/SiteFoot.astro';
import YearIndex from '../../components/YearIndex.astro';
import { getCatalogue } from '../../lib/categories';
import { UI } from '../../i18n';

const lang = 'en' as const;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = base;
/* one list, newest first; the kind of work is a column, not a heading */
const works = (await getCatalogue(lang)).sort((a, b) => b.year - a.year || a.data.title.localeCompare(b.data.title));
const now = works.filter((w) => w.data.current);
---

<Base lang={lang} title={t.index.label} description="Complete list of exhibitions by Studio No Frame, 2014 to 2026: year, place, project and role. Berlin, Istanbul, Venice, Cologne, Duisburg, Chicago.">
  <Chrome lang={lang} here="index" />
  <div class="below"></div>

  <header class="head">
    <h1 class="sr">{t.index.label}</h1>
    {now.length > 0 && (
      <p class="now"><span class="label">{t.now}</span>{now.map((w) => <a href={`${home}/projects/${w.id}`}>{w.data.title}, {w.data.venue}{w.data.dates ? ` — ${w.data.dates}` : ''}</a>)}</p>
    )}
  </header>

  <YearIndex works={works} lang={lang} pad />

  <SiteFoot lang={lang} />
</Base>
