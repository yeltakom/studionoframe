---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[i - 1] ?? projects[projects.length - 1],
      next: projects[i + 1] ?? projects[0],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');
const { title, venue, year, role, summary, images } = project.data;
const [lead, ...rest] = images;
const url = `${site}${base}/projects/${project.id}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: title,
    headline: title,
    description: summary,
    url,
    image: images.map((i) => `${site}${base}${i}`),
    dateCreated: (year.match(/\d{4}/) ?? [''])[0],
    locationCreated: { '@type': 'Place', name: venue },
    creator: { '@type': 'Organization', name: SITE.name, url: `${site}${base}/` },
    creditText: `${role} — ${SITE.name}`,
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Work', item: `${site}${base}/` },
      { '@type': 'ListItem', position: 2, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  title={`${title} — ${venue}`}
  description={summary}
  image={`${base}/images/og/${project.id}.jpg`}
  schema={schema}
>
  <header class="plate-head">
    <h1>{title}</h1>
    <dl class="plate-credits">
      <div><dt class="label">Venue</dt><dd>{venue}</dd></div>
      <div><dt class="label">Year</dt><dd>{year}</dd></div>
      <div><dt class="label">Role</dt><dd>{role}</dd></div>
    </dl>
  </header>

  {lead && (
    <div class="plate-lead">
      <img
        src={`${base}${lead}`}
        alt={`${title} at ${venue}, ${year} — exhibition architecture by Studio No Frame`}
        fetchpriority="high"
        decoding="async"
      />
    </div>
  )}

  <div class="plate-text">
    <div class="prose"><Content /></div>
  </div>

  {rest.length > 0 && (
    <div class="plate-figures">
      {rest.map((image, i) => (
        <figure>
          <img
            src={`${base}${image}`}
            alt={`${title} at ${venue} — installation view ${i + 2}`}
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>
  )}

  <nav class="plate-nav">
    <a href={`${base}/projects/${prev.id}`}>
      <span class="label">Previous</span>
      <strong>{prev.data.title}</strong>
    </a>
    <a href={`${base}/projects/${next.id}`} style="text-align: right; margin-left: auto">
      <span class="label">Next</span>
      <strong>{next.data.title}</strong>
    </a>
  </nav>
</BaseLayout>
