---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import SiteFoot from '../components/SiteFoot.astro';
import Feed from '../components/Feed.astro';
import { getThreaded } from '../lib/threads';
import { studioSchema } from '../lib/schema';
import { UI } from '../i18n';

const lang = 'en' as const;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = base;
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');
const works = await getThreaded(lang);
const now = works.filter((w) => w.data.current);
---

<Base lang={lang} image={`${base}/images/og/default.jpg`} schema={studioSchema(lang, site, base, works)}>
  <Chrome lang={lang} here="home" />
  <div class="below"></div>

  <header class="head">
    <h1>{t.thesis}</h1>
    <p>{t.statement} {t.statementMore}</p>
    {now.length > 0 && (
      <p class="now">
        <span class="label">{t.now}</span>
        {now.map((w) => <a href={`${home}/projects/${w.id}`}>{w.data.title}, {w.data.venue}{w.data.dates ? ` — ${w.data.dates}` : ''}</a>)}
      </p>
    )}
  </header>

  <Feed works={works} lang={lang} root={`${home}/projects`} />

  <SiteFoot lang={lang} />
</Base>
