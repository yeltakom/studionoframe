---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import { getRegister } from '../lib/register';
import { studioSchema } from '../lib/schema';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');
const entries = (await getRegister()).slice().reverse();
---

<Base lang="en" image={`${base}/images/og/default.jpg`} schema={studioSchema('en', site, base, entries)}>
  <Chrome lang="en" here="work" count="01 / 19" />

  <main class="deck">
    {entries.map((e, i) => (
      <a class="poster" href={`${base}/projects/${e.id}`} data-no={String(i + 1).padStart(2, '0')}>
        <img src={`${base}${e.data.cover}`} alt={`${e.data.title} — ${e.data.venue}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        <span class="plate-no">{e.nr}</span>
        <div class="set">
          <h2>{e.data.title}</h2>
          <p class="chip">{e.data.venue} · {e.data.year}<br /><b>{e.data.role}</b></p>
        </div>
      </a>
    ))}
  </main>

  <script is:inline>
    const posters = [...document.querySelectorAll('.poster')];
    const count = document.querySelector('.bar .count');
    const io = new IntersectionObserver((rows) => {
      const top = rows.filter((r) => r.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (top) count.textContent = `${top.target.dataset.no} / ${posters.length}`;
    }, { threshold: [0.3, 0.6, 0.9] });
    posters.forEach((p) => io.observe(p));
  </script>
</Base>
