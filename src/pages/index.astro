---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const years = projects.flatMap((p) => (p.data.year.match(/\d{4}/g) ?? []).map(Number));
const site = (Astro.site ?? new URL(Astro.url.origin)).href.replace(/\/+$/, '');

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site}${base}/#studio`,
    name: SITE.name,
    url: `${site}${base}/`,
    description: SITE.description,
    email: SITE.email,
    founder: { '@type': 'Person', name: SITE.founder, jobTitle: 'Architect and artist' },
    address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: SITE.country },
    knowsAbout: [
      'Exhibition architecture',
      'Exhibition design',
      'Art production',
      'Curation',
      'Scenography',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${SITE.name} — selected exhibitions`,
    url: `${site}${base}/`,
    hasPart: projects.map((p) => ({
      '@type': 'CreativeWork',
      name: p.data.title,
      url: `${site}${base}/projects/${p.id}`,
      dateCreated: (p.data.year.match(/\d{4}/) ?? [''])[0],
      locationCreated: { '@type': 'Place', name: p.data.venue },
    })),
  },
];
---

<BaseLayout
  description={SITE.description}
  image={`${base}/images/og/default.jpg`}
  schema={schema}
>
  <h1 class="standfirst">
    Exhibition architecture, production and curation, from Berlin.{' '}
    <span>
      {projects.length} shows built with museums, biennials and artists since
      {' '}{Math.min(...years)}. Hover a line to see the room it became.
    </span>
  </h1>

  <div class="checklist-head">
    <span class="label">Year</span>
    <span class="label">Exhibition</span>
    <span class="label">Venue</span>
    <span class="label">Role</span>
  </div>

  <ol class="checklist">
    {projects.map((p) => (
      <li>
        <a class="row" href={`${base}/projects/${p.id}`} data-peek={`${base}${p.data.cover}`}>
          <span class="year">{p.data.year}</span>
          <span class="title">{p.data.title}</span>
          <span class="venue">{p.data.venue}</span>
          <span class="role">{p.data.role}</span>
          <img class="thumb-inline" src={`${base}${p.data.cover}`} alt="" loading="lazy" />
        </a>
      </li>
    ))}
  </ol>

  <img class="peek" alt="" aria-hidden="true" />

  <script is:inline>
    const peek = document.querySelector('.peek');
    const rows = document.querySelectorAll('.row[data-peek]');
    let frame = 0;
    const follow = (event) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        peek.style.left = event.clientX + 'px';
        peek.style.top = event.clientY + 'px';
      });
    };
    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => {
        peek.src = row.dataset.peek;
        peek.classList.add('is-visible');
        window.addEventListener('mousemove', follow);
      });
      row.addEventListener('mouseleave', () => {
        peek.classList.remove('is-visible');
        window.removeEventListener('mousemove', follow);
      });
    });
  </script>
</BaseLayout>
