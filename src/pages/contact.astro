---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import SiteFoot from '../components/SiteFoot.astro';
import { SITE } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base title="Contact" description="Commission Studio No Frame for exhibition architecture, production or curation. Write to contact@noframe.studio with the exhibition, venue and dates.">
  <Chrome here="contact" />
  <section class="page">
    <h1>Tell us what you are building.</h1>

    <div class="body">
      <p>
        Write to us with the exhibition, the venue and the dates you are working
        towards, and we will send the full portfolio and a first read on what the
        project needs.
      </p>
      <p style="margin: 2rem 0 2.5rem">
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p>
        Looking for an internship? Read the
        <a href={`${base}/internships`}>internships page</a> first — it explains
        what we offer and what to send.
      </p>
    </div>
  </section>
  <SiteFoot />
</Base>
