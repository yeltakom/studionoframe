---
import Base from '../layouts/Base.astro';
import Chrome from '../components/Chrome.astro';
import SiteFoot from '../components/SiteFoot.astro';
import { SITE } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base title="Contact" description="Commission Studio No Frame for exhibition architecture, production or curation. Write to contact@noframe.studio with the exhibition, venue and dates.">
  <Chrome here="contact" />
  <section class="page">
    <h1>Contact</h1>

    <div class="body">
      <p>
        Studio No Frame, Berlin. For exhibition architecture, production and
        curation, write with the exhibition, the venue and the dates. We reply
        with the full portfolio.
      </p>
      <p>
        <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p>
        Looking for an internship? Read the
        {' '}<a href={`${base}/internships`}>internships page</a>. It explains what
        we offer and what to send.
      </p>
    </div>
  </section>
  <SiteFoot />
</Base>
