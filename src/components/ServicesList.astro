---
/* Services — the five categories, each with its line and its projects. */
import { UI, type Lang } from '../i18n';
import { CATEGORIES, catTitle, catLine, type Entry } from '../lib/categories';
interface Props { works: Entry[]; lang?: Lang }
const { works, lang = 'en' } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
---
<header class="head">
  <h1>{t.services.title}</h1>
  <p>{t.services.line}</p>
</header>
<ol class="services">
  {CATEGORIES.map((c, i) => (
    <li>
      <div>
        <h2><a href={`${home}/category/${c.key}`}>{catTitle(c, lang)}</a></h2>
        <p>{catLine(c, lang)}</p>
      </div>
      <ul>{works.filter((w) => w.cat.key === c.key).sort((a, b) => b.year - a.year).map((w) => <li><a href={`${home}/projects/${w.id}`}><b>{w.data.title}</b> <span>{w.data.venue}, {w.data.year}</span></a></li>)}</ul>
    </li>
  ))}
</ol>
<style>
  /* same thirds as the home page: category and its line on the left, its projects from the figure line, newest first */
  .services { list-style: none; margin: 0; padding: 0 var(--gutter) clamp(3rem, 7vw, 5rem); }
  .services > li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 0.8rem 3rem; padding: 0 0 3rem; }
  .services h2 { margin: 0 0 0.5rem; font-size: 1rem; font-weight: 700; text-transform: uppercase; }
  .services h2 a:hover { text-decoration: underline; }
  .services p { margin: 0; max-width: 40ch; font-weight: 400; line-height: 1.35; }
  .services ul { list-style: none; margin: 0; padding: 0; }
  .services ul li { padding: 0 0 0.45rem; line-height: 1.25; }
  .services ul b { text-transform: uppercase; }
  .services ul span { font-weight: 400; margin-left: 0.6rem; }
  .services ul a:hover b { text-decoration: underline; }
  @media (max-width: 900px) { .services > li { grid-template-columns: 1fr; } .services ul span { display: block; margin: 0.1rem 0 0; } .services ul li { padding-bottom: 0.7rem; } }
</style>
