---
/* Selected — the home page: one statement, then the projects as case files,
   each photograph at the size its evidence deserves, filterable by category.
   The full archive is the Index. */
import { UI, type Lang } from '../i18n';
import { CATEGORIES, catTitle, type Entry } from '../lib/categories';
import { srcset, SIZES } from '../lib/img';

interface Props { works: Entry[]; lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = UI[lang];
const h = t.home;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
const works = [...Astro.props.works].sort((a, b) => b.year - a.year);
const now = works.filter((w) => w.data.current);
---

  <header class="head">
    <h1>{h.title}</h1>
    <p>{h.line}</p>
    {now.length > 0 && (
      <p class="now"><span class="label">{t.now}</span>{now.map((w) => <a href={`${home}/projects/${w.id}`}>{w.data.title}, {w.data.venue}{w.data.dates ? ` — ${w.data.dates}` : ''}</a>)}</p>
    )}
  </header>

  <section class="selected" id="selected">
    <div class="sel-head">
      <h2>{h.selected}</h2>
      <div class="filters" role="group" aria-label={h.filter}>
        <button type="button" data-f="" aria-pressed="true">{h.all}</button>
        {CATEGORIES.map((c) => <button type="button" data-f={c.key} aria-pressed="false">{catTitle(c, lang)}</button>)}
      </div>
    </div>
    <ul class="cases">
      {works.map((w, i) => (
        <li data-c={w.cat.key} class={['s-a', 's-b', '', '', '', 's-c', 's-b', 's-a'][i % 8]}>
          <a href={`${home}/projects/${w.id}`}>
            <span class="fig"><img src={`${base}${w.data.cover}`} srcset={srcset(base, w.data.cover)} sizes="(min-width: 1000px) 66vw, 100vw" alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /><i></i></span>
            <span class="cap"><b>{w.data.title}</b><span class="note"><span class="no">Fig. {String(i + 1).padStart(2, '0')}</span>{w.data.venue}, {w.data.year} · {catTitle(w.cat, lang)}</span></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="all"><a href={`${home}/projects/`}>{h.allProjects}</a></p>
  </section>


<script is:inline>
(() => {
  const items = [...document.querySelectorAll('.cases li')];
  const pattern = ['s-a', 's-b', '', '', '', 's-c', 's-b', 's-a'];
  const relayout = () => { let k = 0; items.forEach((li) => { li.classList.remove('s-a', 's-b', 's-c'); if (!li.hidden) { const c = pattern[k++ % 8]; if (c) li.classList.add(c); } }); };
  const btns = [...document.querySelectorAll('.selected .filters button')];
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    items.forEach((li) => { li.hidden = !!b.dataset.f && li.dataset.c !== b.dataset.f; });
    relayout();
  }));
})();
</script>

<style>

  .selected { padding: clamp(1rem, 3vh, 2rem) var(--gutter) clamp(3rem, 7vw, 5rem); }
  .sel-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.75rem 2rem; padding-bottom: 1rem; }
  .sel-head h2 { margin: 0; font-size: clamp(1.3rem, 2.4vw, 1.9rem); font-weight: 600; font-stretch: 112%; letter-spacing: -0.025em; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.3rem 1.2rem; font-family: var(--mono); font-size: 0.68rem; letter-spacing: 0.02em; }
  .filters button { appearance: none; border: 0; background: none; padding: 0 0 2px; color: var(--grey); cursor: pointer; border-bottom: 1px solid transparent; }
  .filters button:hover { color: var(--ink); }
  .filters button[aria-pressed='true'] { color: var(--mark); border-bottom-color: var(--mark); }

  .all { margin: 2.5rem 0 0; font-size: 1rem; }
  .all a { border-bottom: 1px solid var(--ink); }
  </style>
