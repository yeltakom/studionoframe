---
/* The home page as a ruled sheet. Above: the statement in a narrow cell and
   the figure of the newest project in a wide one. Below: every project as a
   row — the row under the pointer turns black and changes the figure. Then
   the services as five cells. */
import { UI, type Lang } from '../i18n';
import { CATEGORIES, catTitle, catLine, type Entry } from '../lib/categories';
import { srcset } from '../lib/img';
import { SITE } from '../site';

interface Props { works: Entry[]; lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
const works = [...Astro.props.works].sort((a, b) => b.year - a.year);
const first = works.find((w) => w.data.home) ?? works[0];
const de = lang === 'de';
---

<main class="sheet">
  <section class="top">
    <div class="cell about">
      <span class="label">{de ? 'Studio' : 'About'}</span>
      <p class="big">{t.home.title}</p>
      <p>{t.home.line}</p>
      <p>{de
        ? 'Jedes Projekt beginnt bei seinem eigenen Material: den Werken, dem Gebäude, den Menschen, die sich darin bewegen werden.'
        : 'Each project starts from its own material: the works, the building, the people who will move through it.'}</p>
      <p class="more"><a href={`${home}/about`}>{de ? 'Profil' : 'Profile'} →</a></p>
    </div>
    <div class="cell figure" id="figure">
      {works.map((w) => (
        <a href={`${home}/projects/${w.id}`} data-id={w.id} class={w === first ? 'on' : ''} aria-hidden={w === first ? undefined : 'true'} tabindex={w === first ? undefined : -1}>
          <img src={`${base}${w.data.cover}`} srcset={srcset(base, w.data.cover)} sizes="(min-width: 900px) 66vw, 100vw" alt="" loading={w === first ? 'eager' : 'lazy'} decoding="async" />
          <span class="cap"><span>{w.data.title}</span><span>{w.data.venue}, {w.data.year}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="rows">
    <div class="h"><span>{t.columns.no}</span><span>{t.columns.project}</span><span>{t.columns.type}</span><span>{t.columns.venue}</span><span>{t.columns.year}</span></div>
    {works.map((w, i) => (
      <a class="r" href={`${home}/projects/${w.id}`} data-id={w.id}>
        <span>{String(i + 1).padStart(2, '0')}</span>
        <span class="ttl">{w.data.title}</span>
        <span>{catTitle(w.cat, lang)}</span>
        <span>{w.data.venue}</span>
        <span>{w.data.year}</span>
      </a>
    ))}
  </section>

  <section class="cells">
    {CATEGORIES.map((c, i) => (
      <a class="cell" href={`${home}/category/${c.key}`}>
        <span class="label">{t.nav.services} {i + 1}</span>
        <b>{catTitle(c, lang)}</b>
        <span>{catLine(c, lang)}</span>
      </a>
    ))}
    <div class="cell contact">
      <span class="label">{t.nav.contact}</span>
      <b>Studio No Frame</b>
      <span>Berlin / Istanbul<br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a><br /><a href={SITE.instagram} rel="me noopener" target="_blank">Instagram</a></span>
    </div>
  </section>
</main>

<script is:inline>
(() => {
  const figs = [...document.querySelectorAll('#figure a')];
  const show = (id) => figs.forEach((f) => { const on = f.dataset.id === id; f.classList.toggle('on', on); f.tabIndex = on ? 0 : -1; });
  document.querySelectorAll('.rows a[data-id]').forEach((a) => {
    a.addEventListener('pointerenter', () => show(a.dataset.id));
    a.addEventListener('focus', () => show(a.dataset.id));
  });
})();
</script>

<style>
  .sheet { display: block; }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); border-bottom: 1px solid var(--ink); }
  .cell { padding: var(--gutter); }
  .top .about { border-right: 1px solid var(--ink); display: flex; flex-direction: column; }
  .about .label { margin-bottom: 1.2rem; }
  .about p { margin: 0 0 1em; font-size: 1rem; line-height: 1.3; max-width: 40ch; }
  .about .big { font-size: clamp(1.6rem, 2.8vw, 2.6rem); line-height: 1.0; text-transform: uppercase; letter-spacing: -0.01em; margin-bottom: 1.2rem; max-width: 14ch; }
  .about .more { margin-top: auto; margin-bottom: 0; }
  .about a { text-decoration: underline; }
  .figure { position: relative; padding: 0; aspect-ratio: 16 / 10; background: #000; overflow: hidden; }
  .figure a { position: absolute; inset: 0; opacity: 0; transition: opacity 0.25s; }
  .figure a.on { opacity: 1; }
  .figure img { width: 100%; height: 100%; object-fit: cover; }
  .figure .cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem var(--gutter); background: #000; color: #fff; font-size: 0.85rem; text-transform: uppercase; }
  .rows { display: block; }
  .rows .h, .rows .r { display: grid; grid-template-columns: 3rem minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1.2fr) 4rem; gap: 0 1rem; padding: 0.6rem var(--gutter); border-bottom: 1px solid var(--ink); font-size: 0.9rem; line-height: 1.25; align-items: baseline; }
  .rows .h { text-transform: uppercase; font-size: 0.75rem; }
  .rows .r .ttl { text-transform: uppercase; }
  .rows .r:hover { background: #000; color: #fff; text-decoration: none; }
  .rows .r span:last-child { text-align: right; }
  .cells { display: grid; grid-template-columns: repeat(6, 1fr); }
  .cells .cell { border-right: 1px solid var(--ink); display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; line-height: 1.3; min-height: 12rem; }
  .cells .cell:last-child { border-right: 0; }
  .cells .cell b { text-transform: uppercase; font-size: 1rem; }
  .cells a.cell:hover { background: #000; color: #fff; text-decoration: none; }
  .cells a.cell:hover .label { color: #fff; }
  .cells .contact { background: var(--wash); }
  .cells .contact a { text-decoration: underline; }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; }
    .top .about { border-right: 0; border-bottom: 1px solid var(--ink); }
    .rows .h { display: none; }
    .rows .r { grid-template-columns: 2.2rem minmax(0, 1fr) 3.4rem; }
    .rows .r span:nth-child(3), .rows .r span:nth-child(4) { grid-column: 2; font-size: 0.8rem; }
    .cells { grid-template-columns: repeat(2, 1fr); }
    .cells .cell { border-bottom: 1px solid var(--ink); min-height: 0; }
    .cells .cell:nth-child(2n) { border-right: 0; }
  }
</style>
