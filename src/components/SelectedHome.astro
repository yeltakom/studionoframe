---
/* The home page as a ruled sheet. Above: the statement in a narrow cell and
   the figure of the newest project in a wide one. Below: every project as a
   row; the row under the pointer changes the figure. */
import { UI, type Lang } from '../i18n';
import YearIndex from './YearIndex.astro';
import type { Entry } from '../lib/categories';
import { srcset } from '../lib/img';

interface Props { works: Entry[]; lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
const works = [...Astro.props.works].filter((w) => w.data.selected).sort((a, b) => b.year - a.year);
const first = works.find((w) => w.data.home && w.data.cover) ?? works.find((w) => w.data.cover);
const de = lang === 'de';
---

<main class="sheet">
  <section class="top">
    <div class="cell about">
      <span class="label">{de ? 'Studio' : 'About'}</span>
      <p class="big">{t.home.title}</p>
      <p class="led">{t.home.led}</p>
      <h1 class="line">{t.home.line}</h1>
      <p class="more"><a href={`${home}/about`}>{de ? 'Profil' : 'Profile'} →</a></p>
    </div>
    <div class="cell figure" id="figure">
      {works.filter((w) => w.data.cover).map((w) => (
        <a href={`${home}/projects/${w.id}`} data-id={w.id} class={w === first ? 'on' : ''} aria-hidden={w === first ? undefined : 'true'} tabindex={w === first ? undefined : -1}>
          <img src={`${base}${w.data.cover}`} srcset={srcset(base, w.data.cover)} sizes="(min-width: 900px) 66vw, 100vw" alt={`${w.data.title}, ${w.data.venue}`} loading={w === first ? 'eager' : 'lazy'} decoding="async" />
          <span class="cap"><span>{w.data.title}</span><span>{w.data.venue}, {w.data.year}</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="rows"><YearIndex works={works} lang={lang} /></section>

</main>

<script is:inline>
(() => {
  const figs = [...document.querySelectorAll('#figure a')];
  const show = (id) => figs.some((f) => f.dataset.id === id) && figs.forEach((f) => { const on = f.dataset.id === id; f.classList.toggle('on', on); f.tabIndex = on ? 0 : -1; });
  document.querySelectorAll('.rows a[data-id]').forEach((a) => {
    a.addEventListener('pointerenter', () => show(a.dataset.id));
    a.addEventListener('focus', () => show(a.dataset.id));
  });
})();
</script>

<style>
  .sheet { display: block; padding: 0 var(--gutter) 3rem; }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 0 3rem; margin-bottom: 4rem; }
  .cell { padding: 0; }
  .top .about { display: flex; flex-direction: column; }
  .about .label { margin-bottom: 1.2rem; }
  .about p { margin: 0 0 1em; font-size: 1rem; line-height: 1.3; max-width: 40ch; }
  .about .big { margin: 0 0 1.2rem; font-size: clamp(1.6rem, 2.8vw, 2.6rem); line-height: 1.0; text-transform: uppercase; letter-spacing: -0.01em; max-width: 14ch; }
  .about .line { margin: 0 0 1em; font-size: 1rem; line-height: 1.3; max-width: 40ch; font-weight: inherit; text-transform: none; letter-spacing: 0; }
  .about .led { font-size: 0.8rem; font-weight: 400; }
  .about .more { margin-top: auto; margin-bottom: 0; }
  .about a { text-decoration: underline; }
  .figure { position: relative; padding: 0; aspect-ratio: 16 / 10; overflow: visible; }
  .figure a { position: absolute; inset: 0; opacity: 0; transition: opacity 0.25s; }
  .figure a.on { opacity: 1; }
  .figure img { width: 100%; height: 100%; object-fit: contain; object-position: left top; }
  .figure .cap { position: absolute; left: 0; right: 0; top: 100%; display: flex; justify-content: space-between; gap: 1rem; padding: 0.55rem 0; font-size: 0.85rem; text-transform: uppercase; }
  .rows { display: block; margin-bottom: 4rem; }
  @media (max-width: 900px) {
    .top { grid-template-columns: 1fr; gap: 2rem 0; }
    .top .figure { margin-bottom: 2.5rem; }
  }
</style>
