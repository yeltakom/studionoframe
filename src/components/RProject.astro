---
/* A project: title with venue / year and category, the room, then the text
   beside the facts, the plates with their captions, the other projects of the
   category as pictures, and the way on. */
import { UI, type Lang } from '../i18n';
import { srcset, SIZES } from '../lib/img';
import ProjectGrid from './ProjectGrid.astro';
interface Props { p: any; prev: any; next: any; related: any[]; root: string; catHref: string; lang?: Lang }
const { p, prev, next, related = [], root, catHref, lang = 'en' } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const d = p.data;
const [lead, ...rest] = d.images as string[];
const catName = lang === 'de' ? p.cat.de : p.cat.title;
const capOf = (src: string) => (d.captions as { image: string; text: string; credit: string }[]).find((c) => c.image === src || src.endsWith(c.image) || c.image.endsWith(src.split('/').pop() ?? '#'));
const caption = (src: string, n: number) => {
  const c = capOf(src);
  const text = c?.text || `${t.view}${n === 1 ? `, ${d.venue}` : ''}`;
  const credit = c?.credit || d.photo;
  return { text, credit };
};
const facts: [string, string | undefined][] = [
  [t.facts.venue, d.venue],
  [d.dates ? t.facts.dates : t.facts.year, d.dates || d.year],
  [t.facts.role, d.role],
  [t.facts.curator, d.curator],
  [t.facts.graphic, d.graphic],
  [t.facts.client, d.client],
  [t.facts.team, d.team],
  [t.facts.photo, d.photo],
];
---
<header class="pj-head">
  <h1>{d.title}</h1>
  <p class="meta">{d.venue} / {d.year} · <a href={catHref}>{catName}</a></p>
</header>

{lead && (
  <div class="pj-lead">
    <figure class="fig">
      <img src={`${base}${lead}`} srcset={srcset(base, lead)} sizes={SIZES.full} alt={`${d.title} — ${d.venue}`} fetchpriority="high" decoding="async" />
      <i></i>
      <figcaption><b>Fig. 01</b>{caption(lead, 1).text}{caption(lead, 1).credit && <span class="credit"> · {caption(lead, 1).credit}</span>}</figcaption>
    </figure>
  </div>
)}

<div class="pj-body">
  <div class="pj-text"><div class="prose"><slot /></div></div>
  <dl class="pj-facts">
    {facts.filter(([, v]) => v).map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
    <div><dt class="label">{t.columns.type}</dt><dd><a href={catHref}>{catName}</a></dd></div>
  </dl>
</div>

{d.artists && (
  <section class="pj-artists">
    <h2 class="label">{t.facts.artists}</h2>
    <p>{d.artists}</p>
  </section>
)}

{rest.length > 0 && (
  <div class="pj-figs">
    {rest.map((src: string, i: number) => (
      <figure class="fig">
        <img src={`${base}${src}`} srcset={srcset(base, src)} sizes={SIZES.half} alt={capOf(src)?.text || `${d.title} — ${d.venue}`} loading="lazy" decoding="async" />
        <i></i>
        <figcaption><b>Fig. {String(i + 2).padStart(2, '0')}</b>{caption(src, i + 2).text}{caption(src, i + 2).credit && <span class="credit"> · {caption(src, i + 2).credit}</span>}</figcaption>
      </figure>
    ))}
  </div>
)}

{related.length > 0 && (
  <section class="pj-related">
    <h2 class="sec-h">{t.related} <a href={catHref}>{catName}</a></h2>
    <ProjectGrid works={[...related].sort((a, b) => b.year - a.year).slice(0, 3)} lang={lang} />
  </section>
)}

<nav class="pj-nav">
  <a href={`${root}/${prev.id}`}><span class="label">{t.prev}</span><strong>{prev.data.title}</strong></a>
  <a href={`${root}/${next.id}`} style="text-align:right;margin-left:auto"><span class="label">{t.next}</span><strong>{next.data.title}</strong></a>
</nav>

{d.images.length > 0 && (
  <div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label={d.title}>
    <button type="button" class="lb-x" aria-label={lang === 'de' ? 'Schließen' : 'Close'}>×</button>
    <figure class="lb-fig"><img alt="" /><figcaption></figcaption></figure>
    <div class="lb-bar">
      <button type="button" class="lb-p" aria-label={lang === 'de' ? 'Zurück' : 'Previous'}>←</button>
      <span class="lb-c"></span>
      <button type="button" class="lb-n" aria-label={lang === 'de' ? 'Weiter' : 'Next'}>→</button>
    </div>
  </div>
)}

<script is:inline>
(() => {
  /* the photographs open full screen and slide from one to the next */
  const box = document.getElementById('lb');
  if (!box) return;
  const imgs = [...document.querySelectorAll('.pj-lead img, .pj-figs img')];
  const big = box.querySelector('img'), cap = box.querySelector('figcaption'), count = box.querySelector('.lb-c');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = 0, last = null;
  const show = (n, dir) => {
    i = (n + imgs.length) % imgs.length;
    const src = imgs[i];
    big.src = src.getAttribute('src'); big.alt = src.alt;
    const fc = src.closest('figure')?.querySelector('figcaption');
    cap.textContent = fc ? [...fc.childNodes].filter((x) => x.nodeName !== 'B').map((x) => x.textContent).join('').trim() : '';
    count.textContent = `${i + 1} / ${imgs.length}`;
    if (dir && !still) big.animate([{ transform: `translateX(${dir * 3}rem)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 380, easing: 'ease' });
  };
  const open = (n) => {
    last = document.activeElement; show(n, 0); box.hidden = false; document.documentElement.style.overflow = 'hidden';
    if (!still) box.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 250, easing: 'ease' });
    box.querySelector('.lb-x').focus();
  };
  const close = () => { box.hidden = true; document.documentElement.style.overflow = ''; last?.focus?.(); };
  imgs.forEach((im, n) => {
    im.tabIndex = 0; im.setAttribute('role', 'button');
    im.addEventListener('click', () => open(n));
    im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(n); } });
  });
  box.querySelector('.lb-x').addEventListener('click', close);
  box.querySelector('.lb-p').addEventListener('click', () => show(i - 1, -1));
  box.querySelector('.lb-n').addEventListener('click', () => show(i + 1, 1));
  box.addEventListener('click', (e) => { if (e.target === box) close(); });
  document.addEventListener('keydown', (e) => {
    if (box.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') show(i + 1, 1);
    if (e.key === 'ArrowLeft') show(i - 1, -1);
  });
  let x0 = null;
  box.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
  box.addEventListener('pointerup', (e) => {
    if (x0 === null) return; const dx = e.clientX - x0; x0 = null;
    if (Math.abs(dx) > 50) dx < 0 ? show(i + 1, 1) : show(i - 1, -1);
  });
})();
</script>
