---
/* A project, read like an archive entry: number and category, title, the
   room, then the text beside the facts, the plates with their captions, the
   other projects of the category, and the way on. */
import { UI, type Lang } from '../i18n';
import { srcset, SIZES } from '../lib/img';
import IndexTable from './IndexTable.astro';
interface Props { p: any; prev: any; next: any; related: any[]; root: string; catHref: string; lang?: Lang }
const { p, prev, next, related = [], root, catHref, lang = 'en' } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const d = p.data;
const [lead, ...rest] = d.images as string[];
const catName = lang === 'de' ? p.cat.de : p.cat.title;
const capOf = (src: string) => (d.captions as { image: string; text: string; credit: string }[]).find((c) => c.image === src || src.endsWith(c.image) || c.image.endsWith(src.split('/').pop() ?? '#'));
const caption = (src: string, n: number) => {
  const c = capOf(src);
  const text = c?.text || `${t.view}${n === 1 ? `, ${d.venue}` : ''}`;
  const credit = c?.credit || d.photo;
  return { text, credit };
};
const facts: [string, string | undefined][] = [
  [t.facts.venue, d.venue],
  [d.dates ? t.facts.dates : t.facts.year, d.dates || d.year],
  [t.facts.role, d.role],
  [t.facts.curator, d.curator],
  [t.facts.client, d.client],
  [t.facts.team, d.team],
  [t.facts.photo, d.photo],
];
---
<header class="pj-head">
  <span class="no">№ {p.no} · <a href={catHref}>{catName}</a></span>
  <h1>{d.title}</h1>
</header>

{lead && (
  <div class="pj-lead">
    <figure>
      <img src={`${base}${lead}`} srcset={srcset(base, lead)} sizes={SIZES.full} alt={`${d.title} — ${d.venue}`} fetchpriority="high" decoding="async" />
      <figcaption><b>{p.no}.1</b> {caption(lead, 1).text}{caption(lead, 1).credit && <span class="credit"> · {caption(lead, 1).credit}</span>}</figcaption>
    </figure>
  </div>
)}

<div class="pj-body">
  <div class="pj-text"><div class="prose"><slot /></div></div>
  <dl class="pj-facts">
    {facts.filter(([, v]) => v).map(([k, v]) => <div><dt class="label">{k}</dt><dd>{v}</dd></div>)}
    <div><dt class="label">{t.facts.no}</dt><dd>№ {p.no} · <a href={catHref}>{catName}</a></dd></div>
  </dl>
</div>

{rest.length > 0 && (
  <div class="pj-figs">
    {rest.map((src: string, i: number) => (
      <figure>
        <img src={`${base}${src}`} srcset={srcset(base, src)} sizes={SIZES.half} alt={capOf(src)?.text || `${d.title} — ${d.venue}`} loading="lazy" decoding="async" />
        <figcaption><b>{p.no}.{i + 2}</b> {caption(src, i + 2).text}{caption(src, i + 2).credit && <span class="credit"> · {caption(src, i + 2).credit}</span>}</figcaption>
      </figure>
    ))}
  </div>
)}

{related.length > 0 && (
  <section class="pj-related">
    <h2 class="label">{t.related} <a href={catHref}>{catName}</a></h2>
    <IndexTable works={related} lang={lang} root={root} peek={false} head={false} />
  </section>
)}

<nav class="pj-nav">
  <a href={`${root}/${prev.id}`}><span class="label">{t.prev} · {prev.no}</span><strong>{prev.data.title}</strong></a>
  <a href={`${root}/${next.id}`} style="text-align:right;margin-left:auto"><span class="label">{t.next} · {next.no}</span><strong>{next.data.title}</strong></a>
</nav>
