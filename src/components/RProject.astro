---
/* A project: the title, the first photograph across the page, the facts in
   the left third beside the text, then the photographs in rows. Every
   photograph keeps its own proportions; two side by side share one height. */
import { UI, type Lang } from '../i18n';
import { srcset, dims } from '../lib/img';
import ProjectGrid from './ProjectGrid.astro';
interface Props { p: any; prev: any; next: any; related: any[]; root: string; catHref: string; lang?: Lang }
const { p, prev, next, related = [], root, catHref, lang = 'en' } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const d = p.data;
const images = [...new Set(d.images as string[])];
const [lead, ...rest] = images;
const catName = lang === 'de' ? p.cat.de : p.cat.title;
const capOf = (src: string) => (d.captions as { image: string; text: string; credit: string }[]).find((c) => c.image === src || src.endsWith(c.image) || c.image.endsWith(src.split('/').pop() ?? '#'));
const caption = (src: string) => {
  const c = capOf(src);
  const text = (c?.text || '').trim();
  const generic = !text || /^(installation view|ausstellungsansicht)$/i.test(text);
  const credit = (c?.credit || d.photo || '').trim();
  return { text: generic ? '' : text, credit };
};
const ratio = (src: string) => { const { w, h } = dims(src); return w / h; };

/* rows: after the first photograph, pairs and single photographs take turns;
   a single upright photograph is never stretched across the page */
type Row = string[];
const rows: Row[] = [];
const upright = (src: string) => ratio(src) < 1.15;
let queue = [...rest];
/* an upright first photograph never stands alone with white beside it:
   it shares the first row with the next photograph */
const leadRow: Row = lead ? (upright(lead) && queue.length ? [lead, queue.shift()!] : [lead]) : [];
const wide = (src: string) => ratio(src) > 2.2;
let pair = true;
while (queue.length) {
  /* a panorama always has a row of its own; three uprights share one */
  if (wide(queue[0])) { rows.push(queue.splice(0, 1)); pair = true; continue; }
  if (queue.length >= 3 && queue.slice(0, 3).every(upright)) { rows.push(queue.splice(0, 3)); continue; }
  if (queue.length >= 2 && !wide(queue[1]) && (pair || upright(queue[0]))) rows.push(queue.splice(0, 2));
  else rows.push(queue.splice(0, 1));
  pair = !pair;
}
/* a last upright photograph joins the row before it */
const last = rows[rows.length - 1];
if (rows.length > 1 && last.length === 1 && upright(last[0])) rows[rows.length - 2].push(...rows.pop()!);
const facts: [string, string | undefined][] = [
  [t.facts.venue, d.venue],
  [d.dates ? t.facts.dates : t.facts.year, d.dates || d.year],
  [t.facts.role, d.role],
  [t.facts.curator, d.curator],
  [t.facts.client, d.client],
  [t.facts.graphic, d.graphic],
  [t.facts.team, d.team],
  [t.facts.photo, d.photo],
];
const alt = (src: string) => capOf(src)?.text || `${d.title}, ${d.venue}`;
---
<article class="pj">
<header class="pj-head">
  <h1>{d.title}</h1>
  <p class="meta">{d.venue}, {d.year} · <a href={catHref}>{catName}</a></p>
</header>

{leadRow.length > 0 && (
  <div class:list={['pj-row', 'pj-lead', leadRow.length === 1 && 'one', leadRow.length === 1 && upright(leadRow[0]) && 'upright']}>
    {leadRow.map((src, n) => { const c = caption(src); const r = ratio(src); return (
      <figure class="pj-ph" style={`--r:${r.toFixed(4)}`}>
        <img src={`${base}${src}`} srcset={srcset(base, src)} sizes={leadRow.length === 1 ? 'calc(100vw - 30px)' : '(min-width: 760px) 50vw, 100vw'} width={dims(src).w} height={dims(src).h} alt={alt(src)} fetchpriority={n === 0 ? 'high' : undefined} decoding="async" />
        {(c.text || c.credit) && <figcaption>{c.text}{c.text && c.credit && ' · '}{c.credit && <span class="credit">{c.credit}</span>}</figcaption>}
      </figure>
    ); })}
  </div>
)}

<div class="pj-body">
  <dl class="pj-facts">
    {facts.filter(([, v]) => v).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    {d.artists && <div><dt>{t.facts.artists}</dt><dd>{d.artists}</dd></div>}
  </dl>
  <div class="pj-text prose"><slot /></div>
</div>

{rows.length > 0 && (
  <div class="pj-rows">
    {rows.map((row) => (
      <div class:list={['pj-row', row.length === 1 && 'one', row.length === 1 && upright(row[0]) && 'upright']}>
        {row.map((src) => { const c = caption(src); const r = ratio(src); return (
          <figure class="pj-ph" style={`--r:${r.toFixed(4)}`}>
            <img src={`${base}${src}`} srcset={srcset(base, src)} sizes={row.length === 1 ? 'calc(100vw - 30px)' : '(min-width: 760px) 50vw, 100vw'} width={dims(src).w} height={dims(src).h} alt={alt(src)} loading="lazy" decoding="async" />
            {(c.text || c.credit) && <figcaption>{c.text}{c.text && c.credit && ' · '}{c.credit && <span class="credit">{c.credit}</span>}</figcaption>}
          </figure>
        ); })}
      </div>
    ))}
  </div>
)}

{related.length > 0 && (
  <section class="pj-related">
    <h2 class="sec-h">{t.related} <a href={catHref}>{catName}</a></h2>
    <ProjectGrid works={[...related].sort((a, b) => b.year - a.year).slice(0, 3)} lang={lang} />
  </section>
)}

<nav class="pj-nav">
  <a href={`${root}/${prev.id}`}><span>{t.prev}</span><strong>{prev.data.title}</strong></a>
  <a href={`${root}/${next.id}`} class="nx"><span>{t.next}</span><strong>{next.data.title}</strong></a>
</nav>
</article>

{d.images.length > 0 && (
  <div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label={d.title}>
    <button type="button" class="lb-x" aria-label={lang === 'de' ? 'Schließen' : 'Close'}>×</button>
    <figure class="lb-fig"><img alt="" /><figcaption></figcaption></figure>
    <div class="lb-bar">
      <button type="button" class="lb-p" aria-label={lang === 'de' ? 'Zurück' : 'Previous'}>←</button>
      <span class="lb-c"></span>
      <button type="button" class="lb-n" aria-label={lang === 'de' ? 'Weiter' : 'Next'}>→</button>
    </div>
  </div>
)}

<script is:inline>
(() => {
  /* the photographs open full screen and slide from one to the next */
  const box = document.getElementById('lb');
  if (!box) return;
  const imgs = [...document.querySelectorAll('.pj-ph img')];
  const big = box.querySelector('img'), cap = box.querySelector('figcaption'), count = box.querySelector('.lb-c');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let i = 0, last = null;
  const show = (n, dir) => {
    i = (n + imgs.length) % imgs.length;
    const src = imgs[i];
    big.src = src.getAttribute('src'); big.alt = src.alt;
    const fc = src.closest('figure')?.querySelector('figcaption');
    cap.textContent = fc ? fc.textContent.trim() : '';
    count.textContent = `${i + 1} / ${imgs.length}`;
    if (dir && !still) big.animate([{ transform: `translateX(${dir * 3}rem)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 380, easing: 'ease' });
  };
  const open = (n) => {
    last = document.activeElement; show(n, 0); box.hidden = false; document.documentElement.style.overflow = 'hidden';
    if (!still) box.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 250, easing: 'ease' });
    box.querySelector('.lb-x').focus();
  };
  const close = () => { box.hidden = true; document.documentElement.style.overflow = ''; last?.focus?.(); };
  imgs.forEach((im, n) => {
    im.tabIndex = 0; im.setAttribute('role', 'button');
    im.addEventListener('click', () => open(n));
    im.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(n); } });
  });
  box.querySelector('.lb-x').addEventListener('click', close);
  box.querySelector('.lb-p').addEventListener('click', () => show(i - 1, -1));
  box.querySelector('.lb-n').addEventListener('click', () => show(i + 1, 1));
  box.addEventListener('click', (e) => { if (e.target === box) close(); });
  document.addEventListener('keydown', (e) => {
    if (box.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') show(i + 1, 1);
    if (e.key === 'ArrowLeft') show(i - 1, -1);
  });
  let x0 = null;
  box.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
  box.addEventListener('pointerup', (e) => {
    if (x0 === null) return; const dx = e.clientX - x0; x0 = null;
    if (Math.abs(dx) > 50) dx < 0 ? show(i + 1, 1) : show(i - 1, -1);
  });
})();
</script>
