---
/* The home page: one photograph held large, and under it every frame of
   every exhibition as a contact strip. Move along the strip and the large
   photograph follows; click a frame and you are in that exhibition. Left
   alone, it walks through the covers by itself. */
import { UI, type Lang } from '../i18n';
import type { Threaded } from '../lib/threads';
interface Props { works: Threaded[]; lang?: Lang; root: string }
const { works, lang = 'en', root } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const frames = works.flatMap((w) =>
  w.data.images.map((src: string, i: number) => ({
    src: `${base}${src}`, href: `${root}/${w.id}`, id: w.id, first: i === 0,
    cap: `№ ${w.no}.${i + 1} — ${w.data.title}, ${w.data.venue}, ${w.data.year}`,
    alt: `${w.data.title} — ${w.data.venue}`,
  }))
);
/* open on the first room marked "Ana sayfa: evet" (archives first), else the first frame */
const rank = (w: Threaded) => (w.thread.key === 'archives' ? -1 : w.ti);
const opener = works.filter((w) => w.data.home).sort((a, b) => rank(a) - rank(b) || b.year - a.year)[0];
const start = opener ? frames.findIndex((f) => f.id === opener.id && f.first) : 0;
const first = frames[start];
---
<section class="poster" aria-label={t.nav.work}>
  <a class="big" id="big" href={first.href}>
    <img id="big-a" class="is-on" src={first.src} alt={first.alt} fetchpriority="high" decoding="async" />
    <img id="big-b" src="" alt="" decoding="async" />
  </a>
  <p class="cap"><span id="big-cap">{first.cap}</span></p>
</section>

<div class="strip" id="strip" aria-label={t.allWorks}>
  {frames.map((f, i) => (
    <a href={f.href} class={f.first && i > 0 ? 'is-first' : undefined} data-i={i} data-src={f.src} data-cap={f.cap} data-id={f.id} aria-current={i === start ? 'true' : undefined}>
      <img src={f.src} alt="" loading={Math.abs(i - start) < 10 ? 'eager' : 'lazy'} decoding="async" />
    </a>
  ))}
</div>

<script is:inline>
(() => {
  const thumbs = [...document.querySelectorAll('#strip a')];
  const strip = document.getElementById('strip');
  const big = document.getElementById('big');
  const cap = document.getElementById('big-cap');
  const layers = [document.getElementById('big-a'), document.getElementById('big-b')];
  const covers = thumbs.filter((a, i) => i === 0 || a.classList.contains('is-first')).map((a) => Number(a.dataset.i));
  let index = thumbs.findIndex((a) => a.getAttribute('aria-current') === 'true'), front = 0, timer, resting = true;
  if (index < 0) index = 0;
  const cur = thumbs[index];
  if (cur) strip.scrollTo({ left: cur.offsetLeft - strip.clientWidth / 2 + cur.clientWidth / 2 });

  const show = (n, scroll) => {
    index = (n + thumbs.length) % thumbs.length;
    const a = thumbs[index];
    if (layers[front].getAttribute('src') !== a.dataset.src) {
      const next = layers[1 - front];
      next.src = a.dataset.src; next.alt = a.querySelector('img').alt || '';
      const swap = () => { next.classList.add('is-on'); layers[front].classList.remove('is-on'); front = 1 - front; };
      next.complete && next.naturalWidth ? swap() : next.addEventListener('load', swap, { once: true });
    }
    big.href = a.href; cap.textContent = a.dataset.cap;
    thumbs.forEach((x, i) => i === index ? x.setAttribute('aria-current', 'true') : x.removeAttribute('aria-current'));
    if (scroll) strip.scrollTo({ left: a.offsetLeft - strip.clientWidth / 2 + a.clientWidth / 2, behavior: 'smooth' });
  };

  thumbs.forEach((a) => { a.addEventListener('mouseenter', () => show(Number(a.dataset.i), false)); a.addEventListener('focus', () => show(Number(a.dataset.i), false)); });
  strip.addEventListener('mouseenter', () => { resting = false; });
  strip.addEventListener('mouseleave', () => { resting = true; });
  /* a vertical wheel over the strip slides it sideways */
  strip.addEventListener('wheel', (e) => { if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { e.preventDefault(); strip.scrollLeft += e.deltaY; } }, { passive: false });
  window.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') show(index + 1, true); if (e.key === 'ArrowLeft') show(index - 1, true); });

  /* left alone: the next cover every five seconds */
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    timer = setInterval(() => {
      if (!resting || document.hidden) return;
      const k = covers.findIndex((c) => c > index);
      show(covers[k === -1 ? 0 : k], true);
    }, 5000);
  }
})();
</script>
