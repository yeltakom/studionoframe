---
/* The chrome of every page: one white line. The name and the menu stay put,
   the sentence between them runs. */
import { UI, altPath, type Lang } from '../i18n';
import { getCatalogue } from '../lib/categories';

interface Props { lang?: Lang; here?: 'selected' | 'index' | 'about' | 'services' | 'contact' }
const { lang = 'en', here } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
/* the legal pages exist once, in German: their language link goes to the German home */
const other = /\/(impressum|datenschutz)\/?$/.test(Astro.url.pathname) ? `${base}/de/` : altPath(Astro.url.pathname, base);
const now = (await getCatalogue(lang)).filter((w) => w.data.current);
const office = lang === 'de' ? 'Ausstellungsarchitektur · Berlin' : 'Exhibition architecture · Berlin';
---

<header class="rhead" id="rhead">
  <div class="band">
    <a class="studio" href={`${home}/`}>Studio No Frame</a>
    <span class="tick">
      {[0, 1].map((n) => (
        <span class="run" aria-hidden={n ? 'true' : undefined}>
          {[0, 1, 2].map((k) => (
            <span class="item" aria-hidden={n || k ? 'true' : undefined}>
              {now.length > 0 && <>{now.map((w) => <a href={`${home}/projects/${w.id}`} tabindex={n ? -1 : undefined}><b>{t.now}</b> {w.data.title}, {w.data.venue}</a>)} · </>}
              {office}
            </span>
          ))}
        </span>
      ))}
    </span>
  </div>
  <nav aria-label="Site">
    <a href={`${home}/`} aria-current={here === 'selected' ? 'page' : undefined}>{t.nav.selected}</a>
    <a href={`${home}/projects/`} aria-current={here === 'index' ? 'page' : undefined}>{t.nav.index}</a>
    <a href={`${home}/about`} aria-current={here === 'about' ? 'page' : undefined}>{t.nav.studio}</a>
    <a href={`${home}/services`} aria-current={here === 'services' ? 'page' : undefined}>{t.nav.services}</a>
    <a href={`${home}/contact`} aria-current={here === 'contact' ? 'page' : undefined}>{t.nav.contact}</a>
    <a class="lang" href={other} lang={lang === 'de' ? 'en' : 'de'} aria-label={t.switchTo}>{t.short}</a>
  </nav>
</header>

<aside class="wip" id="wip" role="status" hidden>
  <p>{t.home.note}</p>
  <button type="button" aria-label={lang === 'de' ? 'Schließen' : 'Close'}>×</button>
</aside>

<script is:inline>
(() => {
  /* once per visit: it slides in, and it stays closed from page to page */
  const box = document.getElementById('wip');
  let seen = false;
  try { seen = sessionStorage.getItem('wip') === '1'; sessionStorage.setItem('wip', '1'); } catch (e) {}
  if (seen) return;
  box.hidden = false;
  box.querySelector('button').addEventListener('click', () => {
    box.classList.add('out');
    setTimeout(() => { box.hidden = true; }, 450);
  });
})();
</script>
