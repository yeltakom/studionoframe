---
import { UI, altPath, type Lang } from '../i18n';
import IndexOverlay from './IndexOverlay.astro';
import MenuOverlay from './MenuOverlay.astro';

interface Props { lang?: Lang; here?: 'home' | 'work' | 'about' | 'contact'; over?: boolean }
const { lang = 'en', here } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
const other = altPath(Astro.url.pathname, base);
---

<header class="rhead" id="rhead">
  <a class="studio" href={`${home}/`}>Studio No Frame</a>
  <span class="spacer"></span>
  <button type="button" class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="menu">{t.menu}</button>
</header>
<MenuOverlay lang={lang} home={home} other={other} />
{here !== 'work' && <IndexOverlay lang={lang} root={`${home}/projects`} worksHref={`${home}/works`} />}
