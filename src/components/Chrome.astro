---
/* The chrome of every page: the black ticker, then the menu as a row of cells. */
import { UI, altPath, type Lang } from '../i18n';
import { getCatalogue } from '../lib/categories';

interface Props { lang?: Lang; here?: 'selected' | 'index' | 'about' | 'services' | 'contact' }
const { lang = 'en', here } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
const other = altPath(Astro.url.pathname, base);
const now = (await getCatalogue(lang)).filter((w) => w.data.current);
const office = lang === 'de' ? 'Büro für Raumerfahrung und Forschung' : 'Spatial-experience research office';
const line = ['Studio No Frame', office, 'Berlin / Istanbul', ...now.map((w) => `${t.now}: ${w.data.title}, ${w.data.venue}${w.data.dates ? ` — ${w.data.dates}` : ''}`)].join('  ');
---

<header class="rhead" id="rhead">
  <div class="ticker" aria-hidden="true">{[0, 1, 2, 3].map(() => <span>{line}</span>)}</div>
  <a class="studio" href={`${home}/`}>Studio No Frame</a>
  <span class="spacer"></span>
  <nav aria-label="Site">
    <a href={`${home}/`} aria-current={here === 'selected' ? 'page' : undefined}>{t.nav.selected}</a>
    <a href={`${home}/projects/`} aria-current={here === 'index' ? 'page' : undefined}>{t.nav.index}</a>
    <a href={`${home}/about`} aria-current={here === 'about' ? 'page' : undefined}>{t.nav.studio}</a>
    <a href={`${home}/services`} aria-current={here === 'services' ? 'page' : undefined}>{t.nav.services}</a>
    <a href={`${home}/contact`} aria-current={here === 'contact' ? 'page' : undefined}>{t.nav.contact}</a>
    <a class="lang" href={other} lang={lang === 'de' ? 'en' : 'de'} aria-label={t.switchTo}>{t.short}</a>
  </nav>
</header>
