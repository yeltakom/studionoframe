---
import { UI, altPath, type Lang } from '../i18n';
import { SITE } from '../site';

interface Props { lang?: Lang; here?: 'work' | 'about' | 'contact' }
const { lang = 'en', here } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = lang === 'de' ? `${base}/de` : base;
const other = altPath(Astro.url.pathname, base);
---

<header class="site-header">
  <a class="site-title" href={`${home}/`}>Studio No Frame</a>
  <nav class="site-nav">
    <a href={`${home}/`} aria-current={here === 'work' ? 'page' : undefined}>{t.nav.work}</a>
    <a href={`${home}/about`} aria-current={here === 'about' ? 'page' : undefined}>{t.nav.about}</a>
    <a href={`${home}/contact`} aria-current={here === 'contact' ? 'page' : undefined}>{t.nav.contact}</a>
    <a href={other} lang={lang === 'de' ? 'en' : 'de'}>{t.switchTo}</a>
  </nav>
</header>
