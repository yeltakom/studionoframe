---
/* The menu: one white sheet with everything on it. Works and its five
   threads, the index, the studio, contact, the other language. */
import { UI, type Lang } from '../i18n';
import { THREADS } from '../lib/threads';
interface Props { lang?: Lang; home: string; other: string }
const { lang = 'en', home, other } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const tt = (x: (typeof THREADS)[number]) => (lang === 'de' ? x.de : x.title);
---
<div class="menu" id="menu" hidden role="dialog" aria-modal="true" aria-label="Menu">
  <div class="index-bar">
    <a class="studio" href={`${home}/`}>Studio No Frame</a>
    <span class="spacer"></span>
    <button type="button" class="close" id="menu-close" aria-label="Close">×</button>
  </div>
  <nav class="menu-list">
    <a class="big" href={`${home}/`}>{t.nav.work}</a>
    <ol class="threads">
      {THREADS.map((x, i) => <li><a href={`${home}/works/${x.key}`}><span class="no">{i + 1}</span>{tt(x)}</a></li>)}
    </ol>
    <a class="big" href={`${home}/works`} data-index>{t.indexTitle}</a>
    <a class="big" href={`${home}/about`}>{t.nav.about}</a>
    <a class="big" href={`${home}/contact`}>{t.nav.contact}</a>
    <a class="small" href={`${home}/internships`}>{t.footer.internships}</a>
    <a class="small" href={other} lang={lang === 'de' ? 'en' : 'de'}>{t.switchTo}</a>
  </nav>
</div>

<script is:inline>
(() => {
  const menu = document.getElementById('menu');
  const btn = document.getElementById('menu-btn');
  if (!menu || !btn) return;
  let last = null;
  const open = () => { menu.hidden = false; document.body.style.overflow = 'hidden'; last = document.activeElement; menu.querySelector('a').focus({ preventScroll: true }); btn.setAttribute('aria-expanded', 'true'); };
  const close = () => { menu.hidden = true; document.body.style.overflow = ''; btn.setAttribute('aria-expanded', 'false'); last && last.focus(); };
  btn.addEventListener('click', () => (menu.hidden ? open() : close()));
  document.getElementById('menu-close').addEventListener('click', close);
  window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) close(); });
  /* "Index" opens the catalogue sheet over the menu, when the page carries one */
  const ix = menu.querySelector('a[data-index]');
  if (ix) ix.addEventListener('click', (e) => { if (!window.__openIndex) return; e.preventDefault(); close(); window.__openIndex(); });
})();
</script>
