---
/* One large photograph that passes to the next room by itself. The words
   around it stay put; only the small line under it says which room this is. */
import { UI, type Lang } from '../i18n';
import type { Threaded } from '../lib/threads';
interface Props { rooms: Threaded[]; lang?: Lang; root: string }
const { rooms, lang = 'en', root } = Astro.props;
const t = UI[lang];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const caption = (w: Threaded) => `№ ${w.no} — ${w.data.title}, ${w.data.venue}, ${w.data.year}`;
---
<section class="reel" aria-label={t.nav.work}>
  <div class="frame" id="reel">
    {rooms.map((w, i) => (
      <img class={i === 0 ? 'is-on' : ''} data-cap={caption(w)} data-href={`${root}/${w.id}`}
        src={`${base}${w.data.cover}`} alt={`${w.data.title} — ${w.data.venue}`}
        fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
    ))}
  </div>
  <p class="cap">
    <a id="reel-cap" href={`${root}/${rooms[0].id}`}>{caption(rooms[0])}</a>
    <span class="steps"><button type="button" id="reel-prev" aria-label={t.prev}>←</button><button type="button" id="reel-next" aria-label={t.next}>→</button></span>
  </p>
</section>

<script is:inline>
(() => {
  const imgs = [...document.querySelectorAll('#reel img')];
  const cap = document.getElementById('reel-cap');
  if (imgs.length < 2) return;
  let i = 0, timer;
  const go = (n) => {
    i = (n + imgs.length) % imgs.length;
    imgs.forEach((im, k) => im.classList.toggle('is-on', k === i));
    cap.textContent = imgs[i].dataset.cap; cap.href = imgs[i].dataset.href;
  };
  const auto = () => {
    clearInterval(timer);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    timer = setInterval(() => { if (!document.hidden) go(i + 1); }, 5000);
  };
  document.getElementById('reel-next').addEventListener('click', () => { go(i + 1); auto(); });
  document.getElementById('reel-prev').addEventListener('click', () => { go(i - 1); auto(); });
  window.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { go(i + 1); auto(); } if (e.key === 'ArrowLeft') { go(i - 1); auto(); } });
  auto();
})();
</script>
