---
/** Shell for the two Arc UI experiments (uiarc.dev). Arc ships design tokens
 *  in foundation.css and reads `data-theme` / `data-accent` off <html>, so the
 *  shell sets those and nothing else; each design brings its own stylesheet on
 *  top. Kept apart from ThemeShell so the React islands and Arc's tokens never
 *  reach the rest of the site. */
import '../components/arc/foundation.css';

interface Props {
  title: string;
  /** Design key, used as the body class so each stylesheet can scope itself. */
  design: string;
  theme?: 'light' | 'dark';
  /** Arc accent: neutral, violet, blue, green, amber, orange, coral, rose. */
  accent?: string;
  fonts: string;
}
const { title, design, theme = 'light', accent = 'neutral', fonts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<!doctype html>
<html lang="en" data-theme={theme} data-accent={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />
    <title>{title}</title>
  </head>
  <body class={`arc arc-${design}`}>
    <a class="escape" href={`${base}/designs/`}>← Yönler</a>
    <slot />
  </body>
</html>
