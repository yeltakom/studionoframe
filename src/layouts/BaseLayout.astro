---
import { SITE } from '../site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative path of the image used when the page is shared. */
  image?: string;
  /** JSON-LD for this page. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = SITE.description, image, schema } = Astro.props;
const pageTitle = title
  ? `${title} — ${SITE.name}`
  : `${SITE.name} — Exhibition architecture, Berlin`;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.replace(/\/+$/, '');
const absolute = (p: string) => new URL(p, Astro.site ?? Astro.url.origin).href;

const canonical = absolute(Astro.url.pathname);
const shareImage = absolute(image ?? `${base}/images/og/default.jpg`);
const ga = SITE.GA_MEASUREMENT_ID;

const nav = [
  { href: `${base}/`, label: 'Work' },
  { href: `${base}/about`, label: 'About' },
  { href: `${base}/contact`, label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />

    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}

    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={`${base}/`}>Studio No Frame</a>
      <nav class="site-nav">
        {nav.map((item) => (
          <a href={item.href} aria-current={path === item.href.replace(/\/+$/, '') ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Studio No Frame · Berlin</p>
      <nav>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={`${base}/internships`}>Internships</a>
        <a href={`${base}/impressum`}>Impressum</a>
        <a href={`${base}/datenschutz`}>Datenschutz</a>
      </nav>
    </footer>
  </body>
</html>
