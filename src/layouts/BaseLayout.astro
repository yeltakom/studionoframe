---
import { SITE } from '../site';
import { UI, altPath, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  lang?: Lang;
}

const { title, description, image, schema, lang = 'en' } = Astro.props;
const t = UI[lang];

const pageTitle = title ? `${title} — ${SITE.name}` : t.siteTitle;
const pageDescription = description ?? t.description;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.replace(/\/+$/, '');
const absolute = (p: string) => new URL(p, Astro.site ?? Astro.url.origin).href;

const canonical = absolute(Astro.url.pathname);
const other = altPath(Astro.url.pathname, base);
const shareImage = absolute(image ?? `${base}/images/og/default.jpg`);
const ga = SITE.GA_MEASUREMENT_ID;

const home = lang === 'de' ? `${base}/de` : `${base}`;
const nav = [
  { href: `${home}/`, label: t.nav.work },
  { href: `${home}/about`, label: t.nav.about },
  { href: `${home}/contact`, label: t.nav.contact },
];
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'de' ? 'en' : 'de'} href={absolute(other)} />
    <link rel="alternate" hreflang="x-default" href={absolute(lang === 'de' ? other : Astro.url.pathname)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage} />

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />

    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}

    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href={`${home}/`}>Studio No Frame</a>
      <nav class="site-nav">
        {nav.map((item) => (
          <a href={item.href} aria-current={path === item.href.replace(/\/+$/, '') ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
        <a class="lang-switch" href={other} hreflang={lang === 'de' ? 'en' : 'de'} lang={lang === 'de' ? 'en' : 'de'}>
          {t.switchTo}
        </a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Studio No Frame · Berlin</p>
      <nav>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <a href={`${home}/internships`}>{t.footer.internships}</a>
        <a href={`${base}/impressum`}>{t.footer.imprint}</a>
        <a href={`${base}/datenschutz`}>{t.footer.privacy}</a>
      </nav>
    </footer>
  </body>
</html>
