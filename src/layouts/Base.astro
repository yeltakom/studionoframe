---
import { SITE } from '../site';
import { UI, type Lang } from '../i18n';
import '../styles/global.css';
import '../styles/themes.css';

interface Props { title?: string; description?: string; image?: string; lang?: Lang; schema?: any }
const { title, description, image, lang = 'en', schema } = Astro.props;
const t = UI[lang];
const pageTitle = title ? `${title} — ${SITE.name}` : t.siteTitle;
const pageDescription = description ?? t.description;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const absolute = (p: string) => new URL(p, Astro.site ?? Astro.url.origin).href;
const canonical = absolute(Astro.url.pathname);
const share = absolute(image ?? `${base}/images/og/default.jpg`);
const ga = SITE.GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={share} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={share} />
    <script is:inline>
      /* the graphic-language trials: ?theme=spektrum|infrarot|raster sticks until ?theme=off */
      (() => { try {
        const FONTS = 'https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Doto:wght@600;800&family=Instrument+Sans:wght@400;500;600&family=Unbounded:wght@500;700&family=Work+Sans:wght@400;500;600&display=swap';
        const u = new URL(location.href), q = u.searchParams.get('theme'), peek = u.searchParams.has('peek');
        if (peek && q) { document.documentElement.dataset.theme = q; const l = document.createElement('link'); l.rel = 'stylesheet'; l.href = FONTS; document.head.appendChild(l); return; }
        if (q !== null) { q && q !== 'off' ? localStorage.setItem('snf-theme', q) : localStorage.removeItem('snf-theme'); u.searchParams.delete('theme'); history.replaceState(null, '', u); }
        const t = localStorage.getItem('snf-theme');
        if (t) {
          document.documentElement.dataset.theme = t;
          const l = document.createElement('link'); l.rel = 'stylesheet'; l.href = FONTS; document.head.appendChild(l);
          addEventListener('DOMContentLoaded', () => {
            const p = document.createElement('div'); p.className = 'theme-pill';
            p.innerHTML = ['spektrum', 'infrarot', 'raster'].map((k) => `<a href="?theme=${k}" class="${k === t ? 'on' : ''}">${k}</a>`).join('') + '<a href="?theme=off">kapat</a>';
            document.body.appendChild(p);
          });
        }
      } catch (e) {} })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
    {ga && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
        <script is:inline define:vars={{ ga }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga, { anonymize_ip: true });
        </script>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
